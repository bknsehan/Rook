// ─── Type Introspection & Raw Token ─────────────────────────────────────────

TomlType toml_type_of(const char* p) {
    if (!p) return TomlInvalid;
    p = toml_skip_ws(p);
    if (p[0] == '\0') return TomlInvalid;
    char c = p[0];
    if (c == '"' || c == '\'') return TomlString;
    if (c == '[') return TomlArray;
    if (c == '{') return TomlTable;
    if (strncmp(p, "true", 4) == 0 || strncmp(p, "false", 5) == 0) return TomlBoolean;
    if (strncmp(p, "inf", 3) == 0 || strncmp(p, "+inf", 4) == 0 || strncmp(p, "-inf", 4) == 0) return TomlFloat;
    if (strncmp(p, "nan", 3) == 0 || strncmp(p, "+nan", 4) == 0 || strncmp(p, "-nan", 4) == 0) return TomlFloat;
    if (toml_is_date_time(p)) return TomlDateTime;
    if (c == '0' && (p[1] == 'x' || p[1] == 'X' || p[1] == 'o' || p[1] == 'O' || p[1] == 'b' || p[1] == 'B')) {
        return TomlInteger;
    }
    if ((c >= '0' && c <= '9') || c == '+' || c == '-') {
        const char* cur = p;
        if (cur[0] == '+' || cur[0] == '-') cur = cur + 1;
        bool has_dot_or_exp = false;
        while (cur[0] != '\0' && cur[0] != ' ' && cur[0] != '\t' && cur[0] != '\r' &&
               cur[0] != '\n' && cur[0] != '#' && cur[0] != ',' && cur[0] != ']' && cur[0] != '}') {
            if (cur[0] == '.' || cur[0] == 'e' || cur[0] == 'E') {
                has_dot_or_exp = true;
                break;
            }
            cur = cur + 1;
        }
        return has_dot_or_exp ? TomlFloat : TomlInteger;
    }
    return TomlInvalid;
}

TomlType toml_get_type(const char* toml, const char* section, const char* key) {
    const char* p = toml_find(toml, section, key);
    if (!p) return TomlInvalid;
    return toml_type_of(p);
}

bool toml_get_raw(const char* toml, const char* section, const char* key, char* out, size_t cap) {
    if (cap == 0) return false;
    const char* p = toml_find(toml, section, key);
    if (!p) return false;
    p = toml_skip_ws(p);
    const char* end = toml_skip_array_value(p);
    size_t len = (size_t)(end - p);
    if (len + 1 > cap) return false;
    memcpy(out, p, len);
    out[len] = '\0';
    return true;
}

// ─── Array Parsing ──────────────────────────────────────────────────────────

const char* toml_skip_array_value(const char* p) {
    p = toml_skip_ws_and_newlines(p);
    if (!p || p[0] == '\0') return p;
    char c = p[0];
    if (c == '"') {
        if (p[1] == '"' && p[2] == '"') {
            p = p + 3;
            while (p[0] != '\0') {
                if (p[0] == '"' && p[1] == '"' && p[2] == '"') return p + 3;
                p = p + 1;
            }
            return p;
        }
        p = p + 1;
        while (p[0] != '\0' && p[0] != '"') {
            if (p[0] == '\\' && p[1] != '\0') p = p + 2;
            else p = p + 1;
        }
        if (p[0] == '"') p = p + 1;
        return p;
    }
    if (c == '\'') {
        if (p[1] == '\'' && p[2] == '\'') {
            p = p + 3;
            while (p[0] != '\0') {
                if (p[0] == '\'' && p[1] == '\'' && p[2] == '\'') return p + 3;
                p = p + 1;
            }
            return p;
        }
        p = p + 1;
        while (p[0] != '\0' && p[0] != '\'') p = p + 1;
        if (p[0] == '\'') p = p + 1;
        return p;
    }
    if (c == '[') {
        int depth = 1;
        p = p + 1;
        while (p[0] != '\0' && depth > 0) {
            if (p[0] == '[') depth = depth + 1;
            else if (p[0] == ']') depth = depth - 1;
            p = p + 1;
        }
        return p;
    }
    if (c == '{') {
        int depth = 1;
        p = p + 1;
        while (p[0] != '\0' && depth > 0) {
            if (p[0] == '{') depth = depth + 1;
            else if (p[0] == '}') depth = depth - 1;
            p = p + 1;
        }
        return p;
    }
    while (p[0] != '\0' && p[0] != ',' && p[0] != ']' && p[0] != '}' &&
           p[0] != '\r' && p[0] != '\n' && p[0] != '#') {
        p = p + 1;
    }
    return p;
}

int toml_get_array_len(const char* toml, const char* section, const char* key) {
    const char* p = toml_find(toml, section, key);
    if (!p) return -1;
    p = toml_skip_ws_and_newlines(p);
    if (p[0] != '[') return -1;
    p = toml_skip_ws_and_newlines(p + 1);
    if (p[0] == ']') return 0;

    int count = 0;
    while (p[0] != '\0' && p[0] != ']') {
        p = toml_skip_ws_and_newlines(p);
        if (p[0] == '#') { p = toml_skip_line(p); continue; }
        if (p[0] == ']') break;
        p = toml_skip_array_value(p);
        count = count + 1;
        p = toml_skip_ws_and_newlines(p);
        if (p[0] == ',') {
            p = p + 1;
        } else if (p[0] == ']') {
            break;
        } else if (p[0] == '#') {
            p = toml_skip_line(p);
        }
    }
    return count;
}

const char* toml_array_get_elem(const char* toml, const char* section, const char* key, int index) {
    if (index < 0) return NULL;
    const char* p = toml_find(toml, section, key);
    if (!p) return NULL;
    p = toml_skip_ws_and_newlines(p);
    if (p[0] != '[') return NULL;
    p = toml_skip_ws_and_newlines(p + 1);

    int curr = 0;
    while (p[0] != '\0' && p[0] != ']') {
        p = toml_skip_ws_and_newlines(p);
        if (p[0] == '#') { p = toml_skip_line(p); continue; }
        if (p[0] == ']') break;
        if (curr == index) {
            return p;
        }
        p = toml_skip_array_value(p);
        curr = curr + 1;
        p = toml_skip_ws_and_newlines(p);
        if (p[0] == ',') {
            p = p + 1;
        } else if (p[0] == ']') {
            break;
        }
    }
    return NULL;
}

bool toml_array_get_string(const char* toml, const char* section, const char* key, int index, char* out, size_t cap) {
    const char* p = toml_array_get_elem(toml, section, key, index);
    if (!p) return false;
    return toml_parse_string(p, out, cap);
}

