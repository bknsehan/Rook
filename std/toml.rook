// Rook Standard Library - std/toml.rook
// High-performance TOML (Tom's Obvious Minimal Language) parser and serializer.
// Supports sections/tables, nested tables, arrays of tables ([[table]]),
// dotted keys, single/double quoted keys, inline tables ({ x = 1 }),
// typed values (strings with \e/\u/\U/multiline line-continuation, 64-bit ints, floats/inf/nan, bools, datetimes, arrays),
// type introspection (TomlType), raw token queries, safe file loading,
// and zero memory allocation on scans and reads directly over TOML text documents.

#include <stdio.h>
#include <stdlib.h>
#include <stdbool.h>
#include <string.h>
#include <stdint.h>
#include <math.h>
#comprise <std/str>
#comprise <std/vec>

enum TomlType {
    TomlInvalid,
    TomlString,
    TomlInteger,
    TomlFloat,
    TomlBoolean,
    TomlDateTime,
    TomlArray,
    TomlTable
};

const char* toml_skip_ws(const char* p) {
    if (!p) return NULL;
    while (p[0] == ' ' || p[0] == '\t') {
        p = p + 1;
    }
    return p;
}

const char* toml_skip_line(const char* p) {
    if (!p) return NULL;
    while (p[0] != '\0' && p[0] != '\n') {
        p = p + 1;
    }
    if (p[0] == '\n') {
        p = p + 1;
    }
    return p;
}

const char* toml_skip_ws_and_newlines(const char* p) {
    if (!p) return NULL;
    while (p[0] == ' ' || p[0] == '\t' || p[0] == '\r' || p[0] == '\n') {
        p = p + 1;
    }
    return p;
}

int toml_hex_digit(char c) {
    if (c >= '0' && c <= '9') return c - '0';
    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
    return -1;
}

int toml_parse_hex4(const char* p) {
    int h0 = toml_hex_digit(p[0]);
    int h1 = toml_hex_digit(p[1]);
    int h2 = toml_hex_digit(p[2]);
    int h3 = toml_hex_digit(p[3]);
    if (h0 < 0 || h1 < 0 || h2 < 0 || h3 < 0) return -1;
    return (h0 << 12) | (h1 << 8) | (h2 << 4) | h3;
}

bool toml_encode_utf8(uint32_t cp, char* out, size_t* pn, size_t cap) {
    size_t n = *pn;
    if (cp <= 0x7F) {
        if (n + 1 >= cap) return false;
        out[n] = (char)cp;
        *pn = n + 1;
        return true;
    } else if (cp <= 0x7FF) {
        if (n + 2 >= cap) return false;
        out[n] = (char)(0xC0 | (cp >> 6));
        out[n + 1] = (char)(0x80 | (cp & 0x3F));
        *pn = n + 2;
        return true;
    } else if (cp <= 0xFFFF) {
        if (n + 3 >= cap) return false;
        out[n] = (char)(0xE0 | (cp >> 12));
        out[n + 1] = (char)(0x80 | ((cp >> 6) & 0x3F));
        out[n + 2] = (char)(0x80 | (cp & 0x3F));
        *pn = n + 3;
        return true;
    } else if (cp <= 0x10FFFF) {
        if (n + 4 >= cap) return false;
        out[n] = (char)(0xF0 | (cp >> 18));
        out[n + 1] = (char)(0x80 | ((cp >> 12) & 0x3F));
        out[n + 2] = (char)(0x80 | ((cp >> 6) & 0x3F));
        out[n + 3] = (char)(0x80 | (cp & 0x3F));
        *pn = n + 4;
        return true;
    }
    return false;
}

bool toml_is_date_time(const char* p) {
    if (!p) return false;
    p = toml_skip_ws(p);
    // YYYY-MM-DD
    if (p[0] >= '0' && p[0] <= '9' &&
        p[1] >= '0' && p[1] <= '9' &&
        p[2] >= '0' && p[2] <= '9' &&
        p[3] >= '0' && p[3] <= '9' &&
        p[4] == '-' &&
        p[5] >= '0' && p[5] <= '9' &&
        p[6] >= '0' && p[6] <= '9' &&
        p[7] == '-' &&
        p[8] >= '0' && p[8] <= '9' &&
        p[9] >= '0' && p[9] <= '9') {
        return true;
    }
    // HH:MM:SS
    if (p[0] >= '0' && p[0] <= '9' &&
        p[1] >= '0' && p[1] <= '9' &&
        p[2] == ':' &&
        p[3] >= '0' && p[3] <= '9' &&
        p[4] >= '0' && p[4] <= '9' &&
        p[5] == ':' &&
        p[6] >= '0' && p[6] <= '9' &&
        p[7] >= '0' && p[7] <= '9') {
        return true;
    }
    return false;
}

bool toml_parse_date_time(const char* p, char* out, size_t cap) {
    if (!p || cap == 0) return false;
    p = toml_skip_ws(p);
    if (!toml_is_date_time(p)) return false;
    size_t n = 0;
    while (p[0] != '\0' && p[0] != ' ' && p[0] != '\t' && p[0] != '\r' &&
           p[0] != '\n' && p[0] != '#' && p[0] != ',' && p[0] != ']' && p[0] != '}') {
        if (n + 1 >= cap) return false;
        out[n] = p[0];
        n = n + 1;
        p = p + 1;
    }
    out[n] = '\0';
    return true;
}

// Check if a line is a section header: [section]
// Returns 1 if matching standard section [name], 2 if array-of-tables [[name]], 0 otherwise.
int toml_match_section_header(const char* line, const char* target_sec, bool* is_array_table) {
    const char* p = toml_skip_ws(line);
    if (!p || p[0] != '[') return 0;

    bool arr = false;
    if (p[1] == '[') {
        arr = true;
        p = p + 2;
    } else {
        p = p + 1;
    }
    p = toml_skip_ws(p);

    size_t tlen = target_sec ? (size_t)strlen(target_sec) : 0;
    if (strncmp(p, target_sec, tlen) != 0) return 0;
    p = p + tlen;
    p = toml_skip_ws(p);

    if (arr) {
        if (p[0] == ']' && p[1] == ']') {
            if (is_array_table) *is_array_table = true;
            return 2;
        }
    } else {
        if (p[0] == ']' && p[1] != ']') {
            if (is_array_table) *is_array_table = false;
            return 1;
        }
    }
    return 0;
}

// Find start of section in toml. If section is NULL or "", returns start of document.
const char* toml_find_section(const char* toml, const char* section) {
    if (!toml) return NULL;
    if (!section || section[0] == '\0') {
        return toml;
    }
    const char* p = toml;
    while (p[0] != '\0') {
        const char* next_line = toml_skip_line(p);
        bool is_arr = false;
        if (toml_match_section_header(p, section, &is_arr) == 1) {
            return next_line;
        }
        p = next_line;
    }
    return NULL;
}

bool toml_has_section(const char* toml, const char* section) {
    return toml_find_section(toml, section) != NULL;
}

// Count occurrences of [[table_name]] in document
int toml_table_count(const char* toml, const char* table_name) {
    if (!toml || !table_name) return 0;
    const char* p = toml;
    int count = 0;
    while (p[0] != '\0') {
        const char* next_line = toml_skip_line(p);
        bool is_arr = false;
        if (toml_match_section_header(p, table_name, &is_arr) == 2) {
            count = count + 1;
        }
        p = next_line;
    }
    return count;
}

// Locate the index-th occurrence of [[table_name]]
const char* toml_table_at(const char* toml, const char* table_name, int index) {
    if (!toml || !table_name || index < 0) return NULL;
    const char* p = toml;
    int curr = 0;
    while (p[0] != '\0') {
        const char* next_line = toml_skip_line(p);
        bool is_arr = false;
        if (toml_match_section_header(p, table_name, &is_arr) == 2) {
            if (curr == index) {
                return next_line;
            }
            curr = curr + 1;
        }
        p = next_line;
    }
    return NULL;
}

// ─── Value Parsers ──────────────────────────────────────────────────────────

bool toml_parse_string(const char* p, char* out, size_t cap) {
    if (!p || cap == 0) return false;
    p = toml_skip_ws(p);

    // Fallback if value is date-time
    if (toml_is_date_time(p)) {
        return toml_parse_date_time(p, out, cap);
    }

    // 1. Multiline basic string: """..."""
    if (p[0] == '"' && p[1] == '"' && p[2] == '"') {
        p = p + 3;
        // Trim immediate newline after opening """
        if (p[0] == '\r' && p[1] == '\n') p = p + 2;
        else if (p[0] == '\n') p = p + 1;

        size_t n = 0;
        while (p[0] != '\0') {
            if (p[0] == '"' && p[1] == '"' && p[2] == '"') {
                out[n] = '\0';
                return true;
            }
            char c = p[0];
            if (c == '\\') {
                // Check for line continuation
                const char* look = p + 1;
                while (look[0] == ' ' || look[0] == '\t') look = look + 1;
                if (look[0] == '\n' || (look[0] == '\r' && look[1] == '\n')) {
                    p = look;
                    while (p[0] == ' ' || p[0] == '\t' || p[0] == '\r' || p[0] == '\n') {
                        p = p + 1;
                    }
                    continue;
                }
                p = p + 1;
                char e = p[0];
                if (e == 'n') { c = '\n'; p = p + 1; }
                else if (e == 'r') { c = '\r'; p = p + 1; }
                else if (e == 't') { c = '\t'; p = p + 1; }
                else if (e == 'b') { c = '\b'; p = p + 1; }
                else if (e == 'f') { c = '\f'; p = p + 1; }
                else if (e == 'e') { c = '\x1b'; p = p + 1; }
                else if (e == '"') { c = '"'; p = p + 1; }
                else if (e == '\\') { c = '\\'; p = p + 1; }
                else if (e == 'u') {
                    int cp = toml_parse_hex4(p + 1);
                    if (cp < 0) return false;
                    p = p + 5;
                    if (!toml_encode_utf8((uint32_t)cp, out, &n, cap)) return false;
                    continue;
                }
                else if (e == 'U') {
                    int h0 = toml_parse_hex4(p + 1);
                    int h1 = toml_parse_hex4(p + 5);
                    if (h0 < 0 || h1 < 0) return false;
                    uint32_t cp = ((uint32_t)h0 << 16) | (uint32_t)h1;
                    p = p + 9;
                    if (!toml_encode_utf8(cp, out, &n, cap)) return false;
                    continue;
                }
                else {
                    c = e;
                    p = p + 1;
                }
            } else {
                p = p + 1;
            }
            if (n + 1 >= cap) return false;
            out[n] = c;
            n = n + 1;
        }
        return false;
    }

    // 2. Multiline literal string: '''...'''
    if (p[0] == '\'' && p[1] == '\'' && p[2] == '\'') {
        p = p + 3;
        if (p[0] == '\r' && p[1] == '\n') p = p + 2;
        else if (p[0] == '\n') p = p + 1;

        size_t n = 0;
        while (p[0] != '\0') {
            if (p[0] == '\'' && p[1] == '\'' && p[2] == '\'') {
                out[n] = '\0';
                return true;
            }
            if (n + 1 >= cap) return false;
            out[n] = p[0];
            n = n + 1;
            p = p + 1;
        }
        return false;
    }

    // 3. Literal single-line string: '...'
    if (p[0] == '\'') {
        p = p + 1;
        size_t n = 0;
        while (p[0] != '\0' && p[0] != '\'') {
            if (n + 1 >= cap) return false;
            out[n] = p[0];
            n = n + 1;
            p = p + 1;
        }
        if (p[0] != '\'') return false;
        out[n] = '\0';
        return true;
    }

    // 4. Basic single-line string: "..."
    if (p[0] == '"') {
        p = p + 1;
        size_t n = 0;
        while (p[0] != '\0' && p[0] != '"') {
            char c = p[0];
            if (c == '\\') {
                p = p + 1;
                char e = p[0];
                if (e == '\0') break;
                if (e == 'n') { c = '\n'; p = p + 1; }
                else if (e == 'r') { c = '\r'; p = p + 1; }
                else if (e == 't') { c = '\t'; p = p + 1; }
                else if (e == 'b') { c = '\b'; p = p + 1; }
                else if (e == 'f') { c = '\f'; p = p + 1; }
                else if (e == 'e') { c = '\x1b'; p = p + 1; }
                else if (e == '"') { c = '"'; p = p + 1; }
                else if (e == '\\') { c = '\\'; p = p + 1; }
                else if (e == 'u') {
                    int cp = toml_parse_hex4(p + 1);
                    if (cp < 0) return false;
                    p = p + 5;
                    if (!toml_encode_utf8((uint32_t)cp, out, &n, cap)) return false;
                    continue;
                }
                else if (e == 'U') {
                    int h0 = toml_parse_hex4(p + 1);
                    int h1 = toml_parse_hex4(p + 5);
                    if (h0 < 0 || h1 < 0) return false;
                    uint32_t cp = ((uint32_t)h0 << 16) | (uint32_t)h1;
                    p = p + 9;
                    if (!toml_encode_utf8(cp, out, &n, cap)) return false;
                    continue;
                }
                else {
                    c = e;
                    p = p + 1;
                }
            } else {
                p = p + 1;
            }
            if (n + 1 >= cap) return false;
            out[n] = c;
            n = n + 1;
        }
        if (p[0] != '"') return false;
        out[n] = '\0';
        return true;
    }

    return false;
}

bool toml_parse_i64(const char* p, int64_t* out) {
    if (!p) return false;
    p = toml_skip_ws(p);

    int64_t sign = 1;
    if (p[0] == '-') {
        sign = -1;
        p = p + 1;
    } else if (p[0] == '+') {
        p = p + 1;
    }

    // Hex: 0x...
    if (p[0] == '0' && (p[1] == 'x' || p[1] == 'X')) {
        p = p + 2;
        if (p[0] == '_') return false;
        int64_t val = 0;
        bool any = false;
        while (true) {
            if (p[0] == '_') {
                p = p + 1;
                if (toml_hex_digit(p[0]) < 0) return false;
                continue;
            }
            int d = toml_hex_digit(p[0]);
            if (d < 0) break;
            any = true;
            val = (val << 4) | (int64_t)d;
            p = p + 1;
        }
        if (!any) return false;
        if (out) *out = val * sign;
        return true;
    }

    // Binary: 0b...
    if (p[0] == '0' && (p[1] == 'b' || p[1] == 'B')) {
        p = p + 2;
        if (p[0] == '_') return false;
        int64_t val = 0;
        bool any = false;
        while (true) {
            if (p[0] == '_') {
                p = p + 1;
                if (p[0] != '0' && p[0] != '1') return false;
                continue;
            }
            if (p[0] != '0' && p[0] != '1') break;
            any = true;
            val = (val << 1) | (int64_t)(p[0] - '0');
            p = p + 1;
        }
        if (!any) return false;
        if (out) *out = val * sign;
        return true;
    }

    // Octal: 0o...
    if (p[0] == '0' && (p[1] == 'o' || p[1] == 'O')) {
        p = p + 2;
        if (p[0] == '_') return false;
        int64_t val = 0;
        bool any = false;
        while (true) {
            if (p[0] == '_') {
                p = p + 1;
                if (p[0] < '0' || p[0] > '7') return false;
                continue;
            }
            if (p[0] < '0' || p[0] > '7') break;
            any = true;
            val = (val << 3) | (int64_t)(p[0] - '0');
            p = p + 1;
        }
        if (!any) return false;
        if (out) *out = val * sign;
        return true;
    }

    // Decimal
    if (p[0] < '0' || p[0] > '9') return false;
    if (p[0] == '0' && (p[1] >= '0' && p[1] <= '9')) return false;

    int64_t val = 0;
    bool any = false;
    while (true) {
        if (p[0] == '_') {
            p = p + 1;
            if (p[0] < '0' || p[0] > '9') return false;
            continue;
        }
        if (p[0] < '0' || p[0] > '9') break;
        any = true;
        int64_t d = p[0] - '0';
        if (sign > 0) {
            if (val > (9223372036854775807LL - d) / 10) return false;
        } else {
            if (val > (9223372036854775807LL - d) / 10) {
                if (val == 922337203685477580LL && d == 8) {
                    p = p + 1;
                    if (p[0] >= '0' && p[0] <= '9') return false;
                    if (out) *out = -9223372036854775807LL - 1LL;
                    return true;
                }
                return false;
            }
        }
        val = val * 10 + d;
        p = p + 1;
    }
    if (!any) return false;
    if (out) *out = val * sign;
    return true;
}

bool toml_parse_int(const char* p, int* out) {
    int64_t v = 0;
    if (!toml_parse_i64(p, &v)) return false;
    if (v > 2147483647LL || v < -2147483648LL) return false;
    if (out) *out = (int)v;
    return true;
}

bool toml_parse_double(const char* p, double* out) {
    if (!p) return false;
    p = toml_skip_ws(p);

    if (strncmp(p, "+inf", 4) == 0 || strncmp(p, "inf", 3) == 0) {
        if (out) *out = strtod("inf", NULL);
        return true;
    }
    if (strncmp(p, "-inf", 4) == 0) {
        if (out) *out = strtod("-inf", NULL);
        return true;
    }
    if (strncmp(p, "+nan", 4) == 0 || strncmp(p, "-nan", 4) == 0 || strncmp(p, "nan", 3) == 0) {
        if (out) *out = strtod("nan", NULL);
        return true;
    }

    const char* cur = p;
    char clean[128];
    size_t cn = 0;
    if (cur[0] == '+' || cur[0] == '-') {
        clean[cn] = cur[0];
        cn = cn + 1;
        cur = cur + 1;
    }
    if (cur[0] < '0' || cur[0] > '9') return false;

    bool has_frac = false;
    bool has_exp = false;

    while ((cur[0] >= '0' && cur[0] <= '9') || cur[0] == '_') {
        if (cur[0] == '_') {
            cur = cur + 1;
            if (cur[0] < '0' || cur[0] > '9') return false;
            continue;
        }
        if (cn + 1 >= sizeof(clean)) return false;
        clean[cn] = cur[0];
        cn = cn + 1;
        cur = cur + 1;
    }

    if (cur[0] == '.') {
        cur = cur + 1;
        if (cur[0] < '0' || cur[0] > '9') return false; // reject "1."
        has_frac = true;
        clean[cn] = '.';
        cn = cn + 1;
        while ((cur[0] >= '0' && cur[0] <= '9') || cur[0] == '_') {
            if (cur[0] == '_') {
                cur = cur + 1;
                if (cur[0] < '0' || cur[0] > '9') return false;
                continue;
            }
            if (cn + 1 >= sizeof(clean)) return false;
            clean[cn] = cur[0];
            cn = cn + 1;
            cur = cur + 1;
        }
    }

    if (cur[0] == 'e' || cur[0] == 'E') {
        clean[cn] = 'e';
        cn = cn + 1;
        cur = cur + 1;
        if (cur[0] == '+' || cur[0] == '-') {
            clean[cn] = cur[0];
            cn = cn + 1;
            cur = cur + 1;
        }
        if (cur[0] < '0' || cur[0] > '9') return false; // reject "1e"
        has_exp = true;
        while ((cur[0] >= '0' && cur[0] <= '9') || cur[0] == '_') {
            if (cur[0] == '_') {
                cur = cur + 1;
                if (cur[0] < '0' || cur[0] > '9') return false;
                continue;
            }
            if (cn + 1 >= sizeof(clean)) return false;
            clean[cn] = cur[0];
            cn = cn + 1;
            cur = cur + 1;
        }
    }

    if (!has_frac && !has_exp) return false;

    clean[cn] = '\0';
    char* endp = NULL;
    double val = strtod(clean, &endp);
    if (endp == clean) return false;
    if (out) *out = val;
    return true;
}

bool toml_parse_float(const char* p, float* out) {
    double d = 0.0;
    if (!toml_parse_double(p, &d)) return false;
    if (out) *out = (float)d;
    return true;
}

bool toml_parse_bool(const char* p, bool* out) {
    if (!p) return false;
    p = toml_skip_ws(p);
    if (strncmp(p, "true", 4) == 0) {
        char next = p[4];
        if (next == ' ' || next == '\t' || next == '\r' || next == '\n' ||
            next == '#' || next == ',' || next == ']' || next == '}' || next == '\0') {
            if (out) *out = true;
            return true;
        }
    }
    if (strncmp(p, "false", 5) == 0) {
        char next = p[5];
        if (next == ' ' || next == '\t' || next == '\r' || next == '\n' ||
            next == '#' || next == ',' || next == ']' || next == '}' || next == '\0') {
            if (out) *out = false;
            return true;
        }
    }
    return false;
}

// ─── Key Extraction & Resolution ───────────────────────────────────────────

bool toml_extract_key(const char** pp, char* out_key, size_t cap) {
    const char* p = toml_skip_ws(*pp);
    if (!p || p[0] == '\0') return false;
    size_t kn = 0;

    while (true) {
        p = toml_skip_ws(p);
        if (p[0] == '"') {
            p = p + 1;
            while (p[0] != '\0' && p[0] != '"') {
                if (p[0] == '\\' && p[1] != '\0') p = p + 1;
                if (kn + 1 >= cap) return false;
                out_key[kn] = p[0];
                kn = kn + 1;
                p = p + 1;
            }
            if (p[0] != '"') return false;
            p = p + 1;
        } else if (p[0] == '\'') {
            p = p + 1;
            while (p[0] != '\0' && p[0] != '\'') {
                if (kn + 1 >= cap) return false;
                out_key[kn] = p[0];
                kn = kn + 1;
                p = p + 1;
            }
            if (p[0] != '\'') return false;
            p = p + 1;
        } else {
            size_t bare_start = kn;
            while ((p[0] >= 'a' && p[0] <= 'z') || (p[0] >= 'A' && p[0] <= 'Z') ||
                   (p[0] >= '0' && p[0] <= '9') || p[0] == '_' || p[0] == '-') {
                if (kn + 1 >= cap) return false;
                out_key[kn] = p[0];
                kn = kn + 1;
                p = p + 1;
            }
            if (kn == bare_start) return false;
        }

        const char* look = toml_skip_ws(p);
        if (look[0] == '.') {
            if (kn + 1 >= cap) return false;
            out_key[kn] = '.';
            kn = kn + 1;
            p = look + 1;
        } else {
            p = look;
            break;
        }
    }

    out_key[kn] = '\0';
    *pp = p;
    return true;
}

const char* toml_skip_array_value(const char* p);

const char* toml_find_in_inline_table(const char* table_start, const char* target_key) {
    if (!table_start || !target_key) return NULL;
    const char* p = toml_skip_ws(table_start);
    if (p[0] != '{') return NULL;
    p = toml_skip_ws(p + 1);

    while (p[0] != '\0' && p[0] != '}') {
        char kbuf[128];
        const char* kp = p;
        if (!toml_extract_key(&kp, kbuf, sizeof(kbuf))) return NULL;
        kp = toml_skip_ws(kp);
        if (kp[0] != '=') return NULL;
        const char* val_start = toml_skip_ws(kp + 1);

        if (strcmp(kbuf, target_key) == 0) {
            return val_start;
        }

        size_t klen = strlen(kbuf);
        if (strncmp(target_key, kbuf, klen) == 0 && target_key[klen] == '.') {
            if (val_start[0] == '{') {
                const char* sub = toml_find_in_inline_table(val_start, target_key + klen + 1);
                if (sub) return sub;
            }
        }

        p = toml_skip_array_value(val_start);
        p = toml_skip_ws(p);
        if (p[0] == ',') {
            p = toml_skip_ws(p + 1);
        } else if (p[0] == '}') {
            break;
        } else {
            break;
        }
    }
    return NULL;
}

const char* toml_find_key_in_scope(const char* start_ptr, const char* target_key, bool stop_at_next_section) {
    if (!start_ptr || !target_key) return NULL;
    const char* p = start_ptr;

    while (p[0] != '\0') {
        const char* next_line = toml_skip_line(p);
        const char* line = toml_skip_ws(p);

        if (line[0] == '\0' || line[0] == '\r' || line[0] == '\n' || line[0] == '#') {
            p = next_line;
            continue;
        }

        if (line[0] == '[') {
            if (stop_at_next_section) {
                return NULL;
            }
        }

        char kbuf[128];
        const char* cur_p = line;
        if (toml_extract_key(&cur_p, kbuf, sizeof(kbuf))) {
            cur_p = toml_skip_ws(cur_p);
            if (cur_p[0] == '=') {
                const char* val_start = toml_skip_ws(cur_p + 1);
                if (strcmp(kbuf, target_key) == 0) {
                    return val_start;
                }
                size_t klen = strlen(kbuf);
                if (strncmp(target_key, kbuf, klen) == 0 && target_key[klen] == '.') {
                    if (val_start[0] == '{') {
                        const char* sub = toml_find_in_inline_table(val_start, target_key + klen + 1);
                        if (sub) return sub;
                    }
                }
            }
        }

        p = next_line;
    }
    return NULL;
}

const char* toml_find(const char* toml, const char* section, const char* key) {
    if (!toml || !key) return NULL;

    char full_path[256];
    if (section && section[0] != '\0') {
        snprintf(full_path, sizeof(full_path), "%s.%s", section, key);
    } else {
        snprintf(full_path, sizeof(full_path), "%s", key);
    }

    // 1. If explicit section is given, search inside that section
    if (section && section[0] != '\0') {
        const char* sec_start = toml_find_section(toml, section);
        if (sec_start) {
            const char* hit = toml_find_key_in_scope(sec_start, key, true);
            if (hit) return hit;
        }
    }

    // 2. Search root scope for full_path
    const char* root_hit = toml_find_key_in_scope(toml, full_path, true);
    if (root_hit) return root_hit;

    // 3. Search by splitting full_path at dots:
    const char* dot = strrchr(full_path, '.');
    while (dot) {
        size_t sec_len = (size_t)(dot - full_path);
        char sec_buf[128];
        if (sec_len < sizeof(sec_buf)) {
            memcpy(sec_buf, full_path, sec_len);
            sec_buf[sec_len] = '\0';
            const char* sub_key = dot + 1;

            const char* sec_ptr = toml_find_section(toml, sec_buf);
            if (sec_ptr) {
                const char* hit = toml_find_key_in_scope(sec_ptr, sub_key, true);
                if (hit) return hit;
            }
        }
        const char* prev_dot = NULL;
        for (const char* s = full_path; s < dot; s = s + 1) {
            if (s[0] == '.') prev_dot = s;
        }
        dot = prev_dot;
    }

    return NULL;
}

bool toml_has_key(const char* toml, const char* section, const char* key) {
    return toml_find(toml, section, key) != NULL;
}

// Table array lookup
const char* toml_table_find(const char* toml, const char* table_name, int index, const char* key) {
    const char* sec_start = toml_table_at(toml, table_name, index);
    if (!sec_start) return NULL;
    return toml_find_key_in_scope(sec_start, key, true);
}

