// ─── File Helper ───────────────────────────────────────────────────────────

char* toml_load_file(const char* path) {
    if (!path) return NULL;
    FILE* f = fopen(path, "rb");
    if (!f) return NULL;
    fseek(f, 0, 2);
    long sz = ftell(f);
    fseek(f, 0, 0);
    if (sz < 0) {
        fclose(f);
        return NULL;
    }
    char* buf = malloc((size_t)sz + 1);
    if (!buf) {
        fclose(f);
        return NULL;
    }
    size_t rd = fread(buf, 1, (size_t)sz, f);
    buf[rd] = '\0';
    fclose(f);
    return buf;
}

// ─── TomlBuilder (Fluent TOML Serializer) ───────────────────────────────────

struct TomlBuilder {
    sb: StringBuilder;
};

TomlBuilder toml_builder_new(size_t cap) {
    return TomlBuilder {
        sb: sb_new(cap > 0 ? cap : 256)
    };
}

impl TomlBuilder {
    void comment(TomlBuilder* self, const char* text) {
        self->sb.append_cstr("# ");
        if (text) self->sb.append_cstr(text);
        self->sb.append_char('\n');
    }

    void section(TomlBuilder* self, const char* name) {
        self->sb.append_cstr("\n[");
        if (name) self->sb.append_cstr(name);
        self->sb.append_cstr("]\n");
    }

    void table_array(TomlBuilder* self, const char* name) {
        self->sb.append_cstr("\n[[");
        if (name) self->sb.append_cstr(name);
        self->sb.append_cstr("]]\n");
    }

    void set_string(TomlBuilder* self, const char* key, const char* val) {
        if (!key) return;
        self->sb.append_cstr(key);
        self->sb.append_cstr(" = \"");
        if (val) {
            size_t n = (size_t)strlen(val);
            for (size_t i = 0; i < n; i = i + 1) {
                char c = val[i];
                if (c == '"') self->sb.append_cstr("\\\"");
                else if (c == '\\') self->sb.append_cstr("\\\\");
                else if (c == '\n') self->sb.append_cstr("\\n");
                else if (c == '\t') self->sb.append_cstr("\\t");
                else if (c == '\r') self->sb.append_cstr("\\r");
                else if (c == '\x1b') self->sb.append_cstr("\\e");
                else self->sb.append_char(c);
            }
        }
        self->sb.append_cstr("\"\n");
    }

    void set_literal_string(TomlBuilder* self, const char* key, const char* val) {
        if (!key) return;
        self->sb.append_cstr(key);
        self->sb.append_cstr(" = '");
        if (val) self->sb.append_cstr(val);
        self->sb.append_cstr("'\n");
    }

    void set_int(TomlBuilder* self, const char* key, int val) {
        if (!key) return;
        self->sb.append_cstr(key);
        self->sb.append_cstr(" = ");
        self->sb.append_int(val);
        self->sb.append_char('\n');
    }

    void set_i64(TomlBuilder* self, const char* key, int64_t val) {
        if (!key) return;
        self->sb.append_cstr(key);
        self->sb.append_cstr(" = ");
        char buf[64];
        snprintf(buf, sizeof(buf), "%lld", (long long)val);
        self->sb.append_cstr(buf);
        self->sb.append_char('\n');
    }

    void set_float(TomlBuilder* self, const char* key, float val) {
        if (!key) return;
        self->sb.append_cstr(key);
        self->sb.append_cstr(" = ");
        char buf[64];
        snprintf(buf, sizeof(buf), "%.7g", (double)val);
        self->sb.append_cstr(buf);
        self->sb.append_char('\n');
    }

    void set_double(TomlBuilder* self, const char* key, double val) {
        if (!key) return;
        self->sb.append_cstr(key);
        self->sb.append_cstr(" = ");
        char buf[64];
        snprintf(buf, sizeof(buf), "%.14g", val);
        self->sb.append_cstr(buf);
        self->sb.append_char('\n');
    }

    void set_bool(TomlBuilder* self, const char* key, bool val) {
        if (!key) return;
        self->sb.append_cstr(key);
        self->sb.append_cstr(" = ");
        self->sb.append_cstr(val ? "true" : "false");
        self->sb.append_char('\n');
    }

    char* to_cstr(TomlBuilder* self) {
        return self->sb.to_cstr();
    }

    Str as_str(TomlBuilder* self) {
        return self->sb.as_str();
    }

    void destroy(TomlBuilder* self) {
        self->sb.destroy();
    }
};
