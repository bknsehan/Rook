// Rook Standard Library - std/mem.rook
// Fast Linear Arena Allocator, Scoped Scratchpads, Element Pools, and memory utilities.

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdbool.h>

object Arena {
    buffer: char*
    capacity: size_t
    offset: size_t
}

Arena arena_new(size_t capacity) {
    char* buf = (char*)malloc(capacity);
    return Arena {
        buffer: buf,
        capacity: capacity,
        offset: 0
    };
}

impl Arena {
    void* alloc(Arena* self, size_t size) {
        if (!self->buffer) return NULL;
        // Align allocations to 8-byte boundaries
        size_t aligned = (size + 7) & ~7;
        if (self->offset + aligned > self->capacity) {
            return NULL;
        }
        void* ptr = (void*)(self->buffer + self->offset);
        self->offset = self->offset + aligned;
        return ptr;
    }

    void* alloc_aligned(Arena* self, size_t size, size_t alignment) {
        if (!self->buffer || alignment == 0) return NULL;
        size_t mask = alignment - 1;
        size_t current = self->offset;
        size_t aligned_offset = (current + mask) & ~mask;
        if (aligned_offset + size > self->capacity) {
            return NULL;
        }
        self->offset = aligned_offset + size;
        return (void*)(self->buffer + aligned_offset);
    }

    void* alloc_zero(Arena* self, size_t size) {
        void* ptr = self.alloc(size);
        if (!ptr) return NULL;
        memset(ptr, 0, size);
        return ptr;
    }

    void reset(Arena* self) {
        self->offset = 0;
    }

    void destroy(Arena* self) {
        if (self->buffer) {
            free(self->buffer);
            self->buffer = NULL;
        }
        self->capacity = 0;
        self->offset = 0;
    }

    size_t used(Arena* self) {
        return self->offset;
    }

    size_t available(Arena* self) {
        if (self->offset >= self->capacity) return 0;
        return self->capacity - self->offset;
    }
}

// Scoped scratchpad allocator for fast temporary allocations
object ArenaTemp {
    arena: Arena*
    prev_offset: size_t
}

ArenaTemp arena_temp_begin(Arena* arena) {
    size_t prev = 0;
    if (arena) prev = arena->offset;
    return ArenaTemp {
        arena: arena,
        prev_offset: prev
    };
}

void arena_temp_end(ArenaTemp* temp) {
    if (temp && temp->arena) {
        temp->arena->offset = temp->prev_offset;
    }
}

// Fixed-size chunked slot allocator with free-list recycling (Element Pool)
object ElementPool {
    buffer: char*
    slot_size: size_t
    capacity: size_t
    free_head: void*
    allocated_count: size_t
}

ElementPool pool_new(size_t slot_size, size_t capacity) {
    if (slot_size < sizeof(void*)) {
        slot_size = sizeof(void*);
    }
    // 8-byte align slot_size
    slot_size = (slot_size + 7) & ~7;
    char* buf = (char*)malloc(slot_size * capacity);
    void* head = NULL;
    if (buf) {
        for (size_t i = 0; i < capacity; i = i + 1) {
            void* slot = (void*)(buf + i * slot_size);
            void** next_ptr = (void**)slot;
            *next_ptr = head;
            head = slot;
        }
    }
    return ElementPool {
        buffer: buf,
        slot_size: slot_size,
        capacity: capacity,
        free_head: head,
        allocated_count: 0
    };
}

impl ElementPool {
    void* alloc(ElementPool* self) {
        if (!self->free_head) return NULL;
        void* slot = self->free_head;
        void** next_ptr = (void**)slot;
        self->free_head = *next_ptr;
        self->allocated_count = self->allocated_count + 1;
        return slot;
    }

    void free(ElementPool* self, void* ptr) {
        if (!ptr || !self->buffer) return;
        void** next_ptr = (void**)ptr;
        *next_ptr = self->free_head;
        self->free_head = ptr;
        if (self->allocated_count > 0) {
            self->allocated_count = self->allocated_count - 1;
        }
    }

    size_t count(ElementPool* self) {
        return self->allocated_count;
    }

    size_t available(ElementPool* self) {
        if (self->allocated_count >= self->capacity) return 0;
        return self->capacity - self->allocated_count;
    }

    void destroy(ElementPool* self) {
        if (self->buffer) {
            free(self->buffer);
            self->buffer = NULL;
        }
        self->free_head = NULL;
        self->allocated_count = 0;
        self->capacity = 0;
        self->slot_size = 0;
    }
}

void* mem_copy(void* dst, const void* src, size_t n) {
    return memcpy(dst, src, n);
}

void* mem_set(void* dst, int val, size_t n) {
    return memset(dst, val, n);
}

void* mem_zero(void* dst, size_t n) {
    return memset(dst, 0, n);
}

void* mem_alloc(size_t n) {
    return malloc(n);
}

void* mem_realloc(void* ptr, size_t n) {
    return realloc(ptr, n);
}

void mem_free(void* ptr) {
    free(ptr);
}
