// Rook Standard Library - std/fs.rook
// Safe file system operations and zero-allocation path utilities.

#include <stdio.h>
#include <stdlib.h>
#include <stdbool.h>
#include <string.h>
#include <unistd.h>
#comprise <std/result>
#comprise <std/str>

Result fs_read_to_string(const char* path) {
    FILE* f = fopen(path, "rb");
    if (!f) return result_err("could not open file for reading");

    fseek(f, 0, 2); // SEEK_END
    long int sz = ftell(f);
    rewind(f);

    if (sz < 0) {
        fclose(f);
        return result_err("could not determine file size");
    }

    char* buf = malloc((size_t)sz + 1);
    if (!buf) {
        fclose(f);
        return result_err("out of memory while reading file");
    }

    size_t read_bytes = fread(buf, 1, (size_t)sz, f);
    fclose(f);
    buf[read_bytes] = '\0';

    return result_ok(buf);
}

Result fs_write_file(const char* path, const char* content, size_t len) {
    FILE* f = fopen(path, "wb");
    if (!f) return result_err("could not open file for writing");

    size_t written = fwrite(content, 1, len, f);
    fclose(f);

    if (written < len) {
        return result_err("failed to write complete file contents");
    }
    return result_ok(NULL);
}

Result fs_append_file(const char* path, const char* content, size_t len) {
    FILE* f = fopen(path, "ab");
    if (!f) return result_err("could not open file for appending");

    size_t written = fwrite(content, 1, len, f);
    fclose(f);

    if (written < len) {
        return result_err("failed to write complete file contents");
    }
    return result_ok(NULL);
}

long int fs_file_size(const char* path) {
    FILE* f = fopen(path, "rb");
    if (!f) return -1;
    fseek(f, 0, 2);
    long int sz = ftell(f);
    fclose(f);
    return sz;
}

bool fs_exists(const char* path) {
    return access(path, 0) == 0;
}

bool fs_remove_file(const char* path) {
    return unlink(path) == 0;
}

Str path_basename(const char* path) {
    if (!path) return Str { data: "", len: 0 };
    size_t len = strlen(path);
    if (len == 0) return Str { data: "", len: 0 };

    size_t i = len;
    while (i > 0) {
        if (path[i - 1] == '/') {
            return Str { data: path + i, len: len - i };
        }
        i = i - 1;
    }
    return Str { data: path, len: len };
}

Str path_dirname(const char* path) {
    if (!path) return Str { data: ".", len: 1 };
    size_t len = strlen(path);
    if (len == 0) return Str { data: ".", len: 1 };

    size_t i = len;
    while (i > 0) {
        if (path[i - 1] == '/') {
            if (i - 1 == 0) return Str { data: "/", len: 1 };
            return Str { data: path, len: i - 1 };
        }
        i = i - 1;
    }
    return Str { data: ".", len: 1 };
}

Str path_extension(const char* path) {
    if (!path) return Str { data: "", len: 0 };
    size_t len = strlen(path);
    if (len == 0) return Str { data: "", len: 0 };

    size_t i = len;
    while (i > 0) {
        if (path[i - 1] == '.') {
            return Str { data: path + i, len: len - i };
        }
        if (path[i - 1] == '/') {
            break;
        }
        i = i - 1;
    }
    return Str { data: "", len: 0 };
}
