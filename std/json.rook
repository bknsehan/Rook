// Rook Standard Library - std/json.rook
// High-performance JSON parser, validator, path-navigator, and fluent serializer.
// Zero memory allocation on scans and reads.

#include <stdio.h>
#include <stdbool.h>
#include <string.h>
#include <stdlib.h>
#include <stdint.h>
#comprise <std/vec>
#comprise <std/str>

enum JsonType {
    JsonNull,
    JsonBool,
    JsonNumber,
    JsonString,
    JsonArray,
    JsonObject,
    JsonInvalid
};

const char* json_skip_ws(const char* p) {
    if (!p) return NULL;
    while (true) {
        char c = p[0];
        if (c != ' ' && c != '\t' && c != '\n' && c != '\r') {
            break;
        }
        p = p + 1;
    }
    return p;
}

const char* json_skip_string(const char* p) {
    if (!p || p[0] != '"') return p;
    p = p + 1;
    while (p[0] != '\0') {
        if (p[0] == '\\') {
            if (p[1] != '\0') {
                p = p + 2;
            } else {
                p = p + 1;
            }
        } else if (p[0] == '"') {
            return p + 1;
        } else {
            p = p + 1;
        }
    }
    return p;
}

const char* json_skip_value(const char* p) {
    p = json_skip_ws(p);
    if (!p || p[0] == '\0') return p;
    char c = p[0];
    if (c == '"') {
        return json_skip_string(p);
    }
    if (c == '{' || c == '[') {
        int depth = 1;
        p = p + 1;
        while (p[0] != '\0') {
            char d = p[0];
            if (d == '"') {
                p = json_skip_string(p);
            } else {
                if (d == '{' || d == '[') {
                    depth = depth + 1;
                } else if (d == '}' || d == ']') {
                    depth = depth - 1;
                    if (depth == 0) {
                        return p + 1;
                    }
                }
                p = p + 1;
            }
        }
        return p;
    }
    while (p[0] != '\0' && p[0] != ',' && p[0] != '}' && p[0] != ']' &&
           p[0] != ' ' && p[0] != '\t' && p[0] != '\n' && p[0] != '\r') {
        p = p + 1;
    }
    return p;
}

JsonType json_type_of(const char* p) {
    if (!p) return JsonInvalid;
    p = json_skip_ws(p);
    char c = p[0];
    if (c == 'n') {
        if (strncmp(p, "null", 4) == 0) {
            char end = p[4];
            if (end == ' ' || end == '\t' || end == '\r' || end == '\n' ||
                end == ',' || end == '}' || end == ']' || end == '\0') {
                return JsonNull;
            }
        }
        return JsonInvalid;
    }
    if (c == 't') {
        if (strncmp(p, "true", 4) == 0) {
            char end = p[4];
            if (end == ' ' || end == '\t' || end == '\r' || end == '\n' ||
                end == ',' || end == '}' || end == ']' || end == '\0') {
                return JsonBool;
            }
        }
        return JsonInvalid;
    }
    if (c == 'f') {
        if (strncmp(p, "false", 5) == 0) {
            char end = p[5];
            if (end == ' ' || end == '\t' || end == '\r' || end == '\n' ||
                end == ',' || end == '}' || end == ']' || end == '\0') {
                return JsonBool;
            }
        }
        return JsonInvalid;
    }
    if (c == '"') return JsonString;
    if (c == '[') return JsonArray;
    if (c == '{') return JsonObject;
    if ((c >= '0' && c <= '9') || c == '-') return JsonNumber;
    return JsonInvalid;
}

int json_hex_digit(char c) {
    if (c >= '0' && c <= '9') return c - '0';
    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
    return -1;
}

int json_parse_hex4(const char* p) {
    int h0 = json_hex_digit(p[0]);
    int h1 = json_hex_digit(p[1]);
    int h2 = json_hex_digit(p[2]);
    int h3 = json_hex_digit(p[3]);
    if (h0 < 0 || h1 < 0 || h2 < 0 || h3 < 0) return -1;
    return (h0 << 12) | (h1 << 8) | (h2 << 4) | h3;
}

// ─── Value Parsers ──────────────────────────────────────────────────────────

bool json_parse_string(const char* p, char* out, size_t cap) {
    if (!p || cap == 0) return false;
    p = json_skip_ws(p);
    if (p[0] != '"') return false;
    p = p + 1;
    size_t n = 0;
    while (p[0] != '\0' && p[0] != '"') {
        char c = p[0];
        // RFC 8259: unescaped control chars (0x00..0x1F) forbidden in strings
        if ((unsigned char)c < 0x20) {
            return false;
        }
        if (c == '\\') {
            p = p + 1;
            char e = p[0];
            if (e == '\0') return false;
            if (e == 'n') {
                c = '\n';
                p = p + 1;
            } else if (e == 'r') {
                c = '\r';
                p = p + 1;
            } else if (e == 't') {
                c = '\t';
                p = p + 1;
            } else if (e == 'b') {
                c = '\b';
                p = p + 1;
            } else if (e == 'f') {
                c = '\f';
                p = p + 1;
            } else if (e == '"') {
                c = '"';
                p = p + 1;
            } else if (e == '\\') {
                c = '\\';
                p = p + 1;
            } else if (e == '/') {
                c = '/';
                p = p + 1;
            } else if (e == 'u') {
                int cp1 = json_parse_hex4(p + 1);
                if (cp1 < 0) return false;
                p = p + 5; // skip 'u' and 4 hex digits

                uint32_t codepoint = (uint32_t)cp1;
                // Check if high surrogate (0xD800..0xDBFF)
                if (cp1 >= 0xD800 && cp1 <= 0xDBFF) {
                    if (p[0] != '\\' || p[1] != 'u') {
                        return false;
                    }
                    int cp2 = json_parse_hex4(p + 2);
                    if (cp2 < 0xDC00 || cp2 > 0xDFFF) {
                        return false;
                    }
                    p = p + 6; // skip \uXXXX
                    codepoint = 0x10000 + (((uint32_t)(cp1 - 0xD800) << 10) | (uint32_t)(cp2 - 0xDC00));
                } else if (cp1 >= 0xDC00 && cp1 <= 0xDFFF) {
                    return false; // Unpaired low surrogate
                }

                if (codepoint <= 0x7F) {
                    if (n + 1 >= cap) return false;
                    out[n] = (char)codepoint;
                    n = n + 1;
                    continue;
                } else if (codepoint <= 0x7FF) {
                    if (n + 2 >= cap) return false;
                    out[n] = (char)(0xC0 | (codepoint >> 6));
                    out[n + 1] = (char)(0x80 | (codepoint & 0x3F));
                    n = n + 2;
                    continue;
                } else if (codepoint <= 0xFFFF) {
                    if (n + 3 >= cap) return false;
                    out[n] = (char)(0xE0 | (codepoint >> 12));
                    out[n + 1] = (char)(0x80 | ((codepoint >> 6) & 0x3F));
                    out[n + 2] = (char)(0x80 | (codepoint & 0x3F));
                    n = n + 3;
                    continue;
                } else if (codepoint <= 0x10FFFF) {
                    if (n + 4 >= cap) return false;
                    out[n] = (char)(0xF0 | (codepoint >> 18));
                    out[n + 1] = (char)(0x80 | ((codepoint >> 12) & 0x3F));
                    out[n + 2] = (char)(0x80 | ((codepoint >> 6) & 0x3F));
                    out[n + 3] = (char)(0x80 | (codepoint & 0x3F));
                    n = n + 4;
                    continue;
                } else {
                    return false;
                }
            } else {
                return false;
            }
        } else {
            p = p + 1;
        }
        if (n + 1 >= cap) return false;
        out[n] = c;
        n = n + 1;
    }
    if (p[0] != '"') return false;
    out[n] = '\0';
    return true;
}

bool json_parse_i64(const char* p, int64_t* out) {
    if (!p) return false;
    p = json_skip_ws(p);
    int64_t sign = 1;
    if (p[0] == '-') {
        sign = -1;
        p = p + 1;
    }
    if (p[0] < '0' || p[0] > '9') return false;

    // Disallow leading zeroes like 0123
    if (p[0] == '0' && (p[1] >= '0' && p[1] <= '9')) {
        return false;
    }

    int64_t val = 0;
    while (p[0] >= '0' && p[0] <= '9') {
        int64_t d = p[0] - '0';
        if (sign > 0) {
            if (val > (9223372036854775807LL - d) / 10) return false;
        } else {
            if (val > (9223372036854775807LL - d) / 10) {
                if (val == 922337203685477580LL && d == 8) {
                    p = p + 1;
                    if (p[0] >= '0' && p[0] <= '9') return false;
                    if (out) *out = -9223372036854775807LL - 1LL;
                    return true;
                }
                return false;
            }
        }
        val = val * 10 + d;
        p = p + 1;
    }
    if (out) *out = val * sign;
    return true;
}

bool json_parse_int(const char* p, int* out) {
    int64_t v = 0;
    if (!json_parse_i64(p, &v)) return false;
    if (v > 2147483647LL || v < -2147483648LL) return false; // reject overflow
    if (out) *out = (int)v;
    return true;
}

bool json_parse_double(const char* p, double* out) {
    if (!p) return false;
    p = json_skip_ws(p);
    if (p[0] != '-' && (p[0] < '0' || p[0] > '9')) return false;

    const char* cur = p;
    if (cur[0] == '-') cur = cur + 1;
    if (cur[0] < '0' || cur[0] > '9') return false;
    if (cur[0] == '0' && (cur[1] >= '0' && cur[1] <= '9')) return false;
    while (cur[0] >= '0' && cur[0] <= '9') cur = cur + 1;
    if (cur[0] == '.') {
        cur = cur + 1;
        if (cur[0] < '0' || cur[0] > '9') return false;
        while (cur[0] >= '0' && cur[0] <= '9') cur = cur + 1;
    }
    if (cur[0] == 'e' || cur[0] == 'E') {
        cur = cur + 1;
        if (cur[0] == '+' || cur[0] == '-') cur = cur + 1;
        if (cur[0] < '0' || cur[0] > '9') return false;
        while (cur[0] >= '0' && cur[0] <= '9') cur = cur + 1;
    }

    char* endp = NULL;
    double val = strtod(p, &endp);
    if (endp == p) return false;
    if (out) *out = val;
    return true;
}

bool json_parse_float(const char* p, float* out) {
    double d = 0.0;
    if (!json_parse_double(p, &d)) return false;
    if (out) *out = (float)d;
    return true;
}

bool json_parse_bool(const char* p, bool* out) {
    if (!p) return false;
    p = json_skip_ws(p);
    if (strncmp(p, "true", 4) == 0) {
        char t = p[4];
        if (t == ' ' || t == '\t' || t == '\n' || t == '\r' || t == ',' || t == '}' || t == ']' || t == '\0') {
            if (out) *out = true;
            return true;
        }
        return false;
    }
    if (strncmp(p, "false", 5) == 0) {
        char f = p[5];
        if (f == ' ' || f == '\t' || f == '\n' || f == '\r' || f == ',' || f == '}' || f == ']' || f == '\0') {
            if (out) *out = false;
            return true;
        }
        return false;
    }
    return false;
}

// ─── Key Matching & Find ───────────────────────────────────────────────────

bool json_key_match(const char* p, const char* key) {
    if (!p || !key) return false;
    char buf[256];
    if (json_parse_string(p, buf, sizeof(buf))) {
        return strcmp(buf, key) == 0;
    }
    size_t cap = 2048;
    char* big = malloc(cap);
    if (!big) return false;
    bool ok = json_parse_string(p, big, cap);
    bool hit = ok && strcmp(big, key) == 0;
    free(big);
    return hit;
}

const char* json_find(const char* json, const char* key) {
    if (!json || !key) return NULL;
    const char* p = json_skip_ws(json);
    if (!p || p[0] != '{') {
        return NULL;
    }
    p = p + 1;
    while (true) {
        p = json_skip_ws(p);
        if (p[0] == '}' || p[0] == '\0') {
            return NULL;
        }
        if (p[0] != '"') {
            return NULL;
        }
        bool hit = json_key_match(p, key);
        p = json_skip_string(p);
        p = json_skip_ws(p);
        if (p[0] != ':') {
            return NULL;
        }
        p = json_skip_ws(p + 1);
        if (hit) {
            return p;
        }
        p = json_skip_value(p);
        p = json_skip_ws(p);
        if (p[0] == ',') {
            p = p + 1;
        } else if (p[0] == '}') {
            return NULL;
        } else {
            return NULL;
        }
    }
    return NULL;
}

// ─── Array Access ──────────────────────────────────────────────────────────

int json_array_len(const char* arr) {
    if (!arr) return -1;
    const char* p = json_skip_ws(arr);
    if (p[0] != '[') return -1;
    p = json_skip_ws(p + 1);
    if (p[0] == ']') return 0;
    if (p[0] == ',') return -1; // leading comma rejected

    int count = 0;
    while (p[0] != '\0') {
        const char* val_end = json_skip_value(p);
        if (val_end == p) return -1;
        count = count + 1;
        p = json_skip_ws(val_end);
        if (p[0] == ',') {
            p = json_skip_ws(p + 1);
            if (p[0] == ']' || p[0] == ',') {
                return -1; // trailing comma or consecutive comma rejected
            }
        } else if (p[0] == ']') {
            return count;
        } else {
            return -1;
        }
    }
    return -1;
}

const char* json_array_elem(const char* arr, int index) {
    if (!arr || index < 0) return NULL;
    const char* p = json_skip_ws(arr);
    if (p[0] != '[') return NULL;
    p = json_skip_ws(p + 1);
    if (p[0] == ']' || p[0] == ',') return NULL;

    int curr = 0;
    while (p[0] != '\0') {
        if (curr == index) {
            return p;
        }
        const char* val_end = json_skip_value(p);
        if (val_end == p) return NULL;
        curr = curr + 1;
        p = json_skip_ws(val_end);
        if (p[0] == ',') {
            p = json_skip_ws(p + 1);
            if (p[0] == ']' || p[0] == ',') return NULL;
        } else if (p[0] == ']') {
            return NULL;
        } else {
            return NULL;
        }
    }
    return NULL;
}

bool json_array_elem_string(const char* arr, int index, char* out, size_t cap) {
    const char* p = json_array_elem(arr, index);
    if (!p) return false;
    return json_parse_string(p, out, cap);
}

bool json_array_elem_int(const char* arr, int index, int* out) {
    const char* p = json_array_elem(arr, index);
    if (!p) return false;
    return json_parse_int(p, out);
}

bool json_array_elem_i64(const char* arr, int index, int64_t* out) {
    const char* p = json_array_elem(arr, index);
    if (!p) return false;
    return json_parse_i64(p, out);
}

bool json_array_elem_float(const char* arr, int index, float* out) {
    const char* p = json_array_elem(arr, index);
    if (!p) return false;
    return json_parse_float(p, out);
}

bool json_array_elem_double(const char* arr, int index, double* out) {
    const char* p = json_array_elem(arr, index);
    if (!p) return false;
    return json_parse_double(p, out);
}

bool json_array_elem_bool(const char* arr, int index, bool* out) {
    const char* p = json_array_elem(arr, index);
    if (!p) return false;
    return json_parse_bool(p, out);
}

// ─── Path Navigation ───────────────────────────────────────────────────────

const char* json_find_path(const char* json, const char* path) {
    if (!json || !path) return NULL;
    const char* curr = json_skip_ws(json);
    const char* p = path;

    while (p[0] != '\0') {
        if (p[0] == '.') {
            p = p + 1;
            continue;
        }
        if (p[0] == '[') {
            p = p + 1;
            if (p[0] == '"' || p[0] == '\'') {
                char quote = p[0];
                p = p + 1;
                const char* kstart = p;
                while (p[0] != '\0' && p[0] != quote) {
                    p = p + 1;
                }
                if (p[0] != quote) return NULL;
                size_t klen = (size_t)(p - kstart);
                p = p + 1; // skip quote
                p = json_skip_ws(p);
                if (p[0] != ']') return NULL;
                p = p + 1; // skip ']'
                char kbuf[256];
                if (klen >= sizeof(kbuf)) return NULL;
                memcpy(kbuf, kstart, klen);
                kbuf[klen] = '\0';
                curr = json_find(curr, kbuf);
                if (!curr) return NULL;
                curr = json_skip_ws(curr);
                continue;
            }
            int idx = 0;
            bool has_digits = false;
            while (p[0] >= '0' && p[0] <= '9') {
                has_digits = true;
                idx = idx * 10 + (p[0] - '0');
                p = p + 1;
            }
            if (!has_digits || p[0] != ']') return NULL;
            p = p + 1; // skip ']'
            curr = json_array_elem(curr, idx);
            if (!curr) return NULL;
            curr = json_skip_ws(curr);
            continue;
        }

        char buf[256];
        size_t seg_len = 0;
        while (p[0] != '\0' && p[0] != '.' && p[0] != '[') {
            if (p[0] == '\\' && p[1] == '.') {
                p = p + 1; // skip '\'
            }
            if (seg_len + 1 >= sizeof(buf)) return NULL;
            buf[seg_len] = p[0];
            seg_len = seg_len + 1;
            p = p + 1;
        }
        if (seg_len == 0) return NULL;
        buf[seg_len] = '\0';

        curr = json_skip_ws(curr);
        if (curr[0] == '[') {
            bool all_digits = true;
            for (size_t i = 0; i < seg_len; i = i + 1) {
                if (buf[i] < '0' || buf[i] > '9') {
                    all_digits = false;
                    break;
                }
            }
            if (all_digits) {
                int idx = atoi(buf);
                curr = json_array_elem(curr, idx);
                if (!curr) return NULL;
                curr = json_skip_ws(curr);
                continue;
            }
        }

        curr = json_find(curr, buf);
        if (!curr) return NULL;
        curr = json_skip_ws(curr);
    }
    return curr;
}

// Unified finder: direct key check first, then path check
const char* json_get(const char* json, const char* key_or_path) {
    if (!json || !key_or_path) return NULL;
    const char* p = json_find(json, key_or_path);
    if (p) return p;
    if (strchr(key_or_path, '.') || strchr(key_or_path, '[')) {
        return json_find_path(json, key_or_path);
    }
    return NULL;
}

bool json_has_key(const char* json, const char* key) {
    return json_get(json, key) != NULL;
}

bool json_has_path(const char* json, const char* path) {
    return json_find_path(json, path) != NULL;
}

// ─── Query Getters (Unified Paths & Keys) ───────────────────────────────────

bool json_get_string(const char* json, const char* key, char* out, size_t cap) {
    const char* p = json_get(json, key);
    if (!p) return false;
    return json_parse_string(p, out, cap);
}

bool json_get_int(const char* json, const char* key, int* out) {
    const char* p = json_get(json, key);
    if (!p) return false;
    return json_parse_int(p, out);
}

bool json_get_i64(const char* json, const char* key, int64_t* out) {
    const char* p = json_get(json, key);
    if (!p) return false;
    return json_parse_i64(p, out);
}

bool json_get_float(const char* json, const char* key, float* out) {
    const char* p = json_get(json, key);
    if (!p) return false;
    return json_parse_float(p, out);
}

bool json_get_double(const char* json, const char* key, double* out) {
    const char* p = json_get(json, key);
    if (!p) return false;
    return json_parse_double(p, out);
}

bool json_get_bool(const char* json, const char* key, bool* out) {
    const char* p = json_get(json, key);
    if (!p) return false;
    return json_parse_bool(p, out);
}

JsonType json_get_type(const char* json, const char* key) {
    const char* p = json_get(json, key);
    if (!p) return JsonInvalid;
    return json_type_of(p);
}

bool json_is_null(const char* json, const char* key) {
    const char* p = json_get(json, key);
    if (!p) return false;
    p = json_skip_ws(p);
    return strncmp(p, "null", 4) == 0;
}

bool json_get_raw(const char* json, const char* key, char* out, size_t cap) {
    if (cap == 0) return false;
    const char* p = json_get(json, key);
    if (!p) return false;
    const char* end = json_skip_value(p);
    size_t len = (size_t)(end - p);
    if (len + 1 > cap) return false;
    memcpy(out, p, len);
    out[len] = '\0';
    return true;
}

bool json_get_object(const char* json, const char* key, char* out, size_t cap) {
    const char* p = json_get(json, key);
    if (!p) return false;
    p = json_skip_ws(p);
    if (p[0] != '{') return false;
    return json_get_raw(json, key, out, cap);
}

bool json_get_array(const char* json, const char* key, char* out, size_t cap) {
    const char* p = json_get(json, key);
    if (!p) return false;
    p = json_skip_ws(p);
    if (p[0] != '[') return false;
    return json_get_raw(json, key, out, cap);
}

int json_get_array_len(const char* json, const char* key) {
    const char* p = json_get(json, key);
    if (!p) return -1;
    return json_array_len(p);
}

const char* json_array_get_elem(const char* json, const char* key, int index) {
    const char* p = json_get(json, key);
    if (!p) return NULL;
    return json_array_elem(p, index);
}

bool json_array_get_string(const char* json, const char* key, int index, char* out, size_t cap) {
    return json_array_elem_string(json_get(json, key), index, out, cap);
}

bool json_array_get_int(const char* json, const char* key, int index, int* out) {
    return json_array_elem_int(json_get(json, key), index, out);
}

bool json_array_get_i64(const char* json, const char* key, int index, int64_t* out) {
    return json_array_elem_i64(json_get(json, key), index, out);
}

bool json_array_get_float(const char* json, const char* key, int index, float* out) {
    return json_array_elem_float(json_get(json, key), index, out);
}

bool json_array_get_double(const char* json, const char* key, int index, double* out) {
    return json_array_elem_double(json_get(json, key), index, out);
}

bool json_array_get_bool(const char* json, const char* key, int index, bool* out) {
    return json_array_elem_bool(json_get(json, key), index, out);
}

