// ─── Structural Validation ─────────────────────────────────────────────────

bool json_validate_value(const char** pp);

bool json_validate_string(const char** pp) {
    const char* p = *pp;
    if (p[0] != '"') {
        *pp = p;
        return false;
    }
    p = p + 1;
    while (p[0] != '\0' && p[0] != '"') {
        if ((unsigned char)p[0] < 0x20) {
            *pp = p;
            return false;
        }
        if (p[0] == '\\') {
            p = p + 1;
            char e = p[0];
            if (e == '"' || e == '\\' || e == '/' || e == 'b' || e == 'f' || e == 'n' || e == 'r' || e == 't') {
                p = p + 1;
            } else if (e == 'u') {
                int cp1 = json_parse_hex4(p + 1);
                if (cp1 < 0) {
                    *pp = p;
                    return false;
                }
                p = p + 5;
                if (cp1 >= 0xD800 && cp1 <= 0xDBFF) {
                    if (p[0] != '\\' || p[1] != 'u') {
                        *pp = p;
                        return false;
                    }
                    int cp2 = json_parse_hex4(p + 2);
                    if (cp2 < 0xDC00 || cp2 > 0xDFFF) {
                        *pp = p;
                        return false;
                    }
                    p = p + 6;
                } else if (cp1 >= 0xDC00 && cp1 <= 0xDFFF) {
                    *pp = p;
                    return false;
                }
            } else {
                *pp = p;
                return false;
            }
        } else {
            p = p + 1;
        }
    }
    if (p[0] != '"') {
        *pp = p;
        return false;
    }
    *pp = p + 1;
    return true;
}

bool json_validate_number(const char** pp) {
    const char* p = *pp;
    if (p[0] == '-') p = p + 1;
    if (p[0] < '0' || p[0] > '9') {
        *pp = p;
        return false;
    }
    if (p[0] == '0') {
        p = p + 1;
        if (p[0] >= '0' && p[0] <= '9') {
            *pp = p;
            return false;
        }
    } else {
        while (p[0] >= '0' && p[0] <= '9') p = p + 1;
    }
    if (p[0] == '.') {
        p = p + 1;
        if (p[0] < '0' || p[0] > '9') {
            *pp = p;
            return false;
        }
        while (p[0] >= '0' && p[0] <= '9') p = p + 1;
    }
    if (p[0] == 'e' || p[0] == 'E') {
        p = p + 1;
        if (p[0] == '+' || p[0] == '-') p = p + 1;
        if (p[0] < '0' || p[0] > '9') {
            *pp = p;
            return false;
        }
        while (p[0] >= '0' && p[0] <= '9') p = p + 1;
    }
    *pp = p;
    return true;
}

bool json_validate_value(const char** pp) {
    const char* p = json_skip_ws(*pp);
    if (!p || p[0] == '\0') {
        *pp = p;
        return false;
    }
    char c = p[0];
    if (c == '"') {
        *pp = p;
        return json_validate_string(pp);
    }
    if (c == '{') {
        p = json_skip_ws(p + 1);
        if (p[0] == '}') {
            *pp = p + 1;
            return true;
        }
        while (true) {
            p = json_skip_ws(p);
            if (p[0] != '"') {
                *pp = p;
                return false;
            }
            const char* kp = p;
            if (!json_validate_string(&kp)) {
                *pp = kp;
                return false;
            }
            p = json_skip_ws(kp);
            if (p[0] != ':') {
                *pp = p;
                return false;
            }
            p = json_skip_ws(p + 1);
            const char* vp = p;
            if (!json_validate_value(&vp)) {
                *pp = vp;
                return false;
            }
            p = json_skip_ws(vp);
            if (p[0] == ',') {
                p = json_skip_ws(p + 1);
                if (p[0] == '}') {
                    *pp = p;
                    return false;
                }
            } else if (p[0] == '}') {
                *pp = p + 1;
                return true;
            } else {
                *pp = p;
                return false;
            }
        }
    }
    if (c == '[') {
        p = json_skip_ws(p + 1);
        if (p[0] == ']') {
            *pp = p + 1;
            return true;
        }
        if (p[0] == ',') {
            *pp = p;
            return false;
        }
        while (true) {
            p = json_skip_ws(p);
            const char* vp = p;
            if (!json_validate_value(&vp)) {
                *pp = vp;
                return false;
            }
            p = json_skip_ws(vp);
            if (p[0] == ',') {
                p = json_skip_ws(p + 1);
                if (p[0] == ']' || p[0] == ',') {
                    *pp = p;
                    return false;
                }
            } else if (p[0] == ']') {
                *pp = p + 1;
                return true;
            } else {
                *pp = p;
                return false;
            }
        }
    }
    if (c == 't') {
        if (strncmp(p, "true", 4) == 0) {
            *pp = p + 4;
            return true;
        }
        *pp = p;
        return false;
    }
    if (c == 'f') {
        if (strncmp(p, "false", 5) == 0) {
            *pp = p + 5;
            return true;
        }
        *pp = p;
        return false;
    }
    if (c == 'n') {
        if (strncmp(p, "null", 4) == 0) {
            *pp = p + 4;
            return true;
        }
        *pp = p;
        return false;
    }
    if ((c >= '0' && c <= '9') || c == '-') {
        *pp = p;
        return json_validate_number(pp);
    }
    *pp = p;
    return false;
}

bool json_valid_ex(const char* json, int* out_line, int* out_col) {
    if (!json) {
        if (out_line) *out_line = 0;
        if (out_col) *out_col = 0;
        return false;
    }
    const char* p = json_skip_ws(json);
    if (!p || p[0] == '\0') {
        if (out_line) *out_line = 1;
        if (out_col) *out_col = 1;
        return false;
    }
    const char* p_start = p;
    if (!json_validate_value(&p)) {
        int line = 1;
        int col = 1;
        for (const char* s = json; s < p && s[0] != '\0'; s = s + 1) {
            if (s[0] == '\n') { line = line + 1; col = 1; }
            else { col = col + 1; }
        }
        if (out_line) *out_line = line;
        if (out_col) *out_col = col;
        return false;
    }
    p = json_skip_ws(p);
    if (p[0] != '\0') {
        int line = 1;
        int col = 1;
        for (const char* s = json; s < p && s[0] != '\0'; s = s + 1) {
            if (s[0] == '\n') { line = line + 1; col = 1; }
            else { col = col + 1; }
        }
        if (out_line) *out_line = line;
        if (out_col) *out_col = col;
        return false;
    }
    return true;
}

bool json_valid(const char* json) {
    return json_valid_ex(json, NULL, NULL);
}

// ─── File Helper & Pretty Printing ─────────────────────────────────────────

char* json_load_file_capped(const char* path, size_t max_bytes) {
    if (!path) return NULL;
    FILE* f = fopen(path, "rb");
    if (!f) return NULL;
    fseek(f, 0, 2);
    long sz = ftell(f);
    fseek(f, 0, 0);
    if (sz < 0 || (max_bytes > 0 && (size_t)sz > max_bytes)) {
        fclose(f);
        return NULL;
    }
    char* buf = malloc((size_t)sz + 1);
    if (!buf) {
        fclose(f);
        return NULL;
    }
    size_t rd = fread(buf, 1, (size_t)sz, f);
    buf[rd] = '\0';
    fclose(f);
    return buf;
}

char* json_load_file(const char* path) {
    return json_load_file_capped(path, 64 * 1024 * 1024); // 64 MB default cap
}

char* json_format_pretty(const char* json, int indent_spaces) {
    if (!json) return NULL;
    if (indent_spaces <= 0) indent_spaces = 2;
    StringBuilder sb = sb_new(strlen(json) * 2);
    const char* p = json;
    int indent = 0;
    bool in_str = false;

    while (p[0] != '\0') {
        char c = p[0];
        if (in_str) {
            sb.append_char(c);
            if (c == '\\' && p[1] != '\0') {
                sb.append_char(p[1]);
                p = p + 2;
                continue;
            }
            if (c == '"') in_str = false;
            p = p + 1;
            continue;
        }

        if (c == '"') {
            in_str = true;
            sb.append_char(c);
            p = p + 1;
            continue;
        }

        if (c == ' ' || c == '\t' || c == '\r' || c == '\n') {
            p = p + 1;
            continue;
        }

        if (c == '{' || c == '[') {
            sb.append_char(c);
            const char* next = json_skip_ws(p + 1);
            if (next[0] == '}' || next[0] == ']') {
                sb.append_char(next[0]);
                p = next + 1;
                continue;
            }
            indent = indent + indent_spaces;
            sb.append_char('\n');
            for (int i = 0; i < indent; i = i + 1) sb.append_char(' ');
            p = p + 1;
            continue;
        }

        if (c == '}' || c == ']') {
            indent = indent - indent_spaces;
            if (indent < 0) indent = 0;
            sb.append_char('\n');
            for (int i = 0; i < indent; i = i + 1) sb.append_char(' ');
            sb.append_char(c);
            p = p + 1;
            continue;
        }

        if (c == ':') {
            sb.append_cstr(": ");
            p = p + 1;
            continue;
        }

        if (c == ',') {
            sb.append_char(',');
            sb.append_char('\n');
            for (int i = 0; i < indent; i = i + 1) sb.append_char(' ');
            p = p + 1;
            continue;
        }

        sb.append_char(c);
        p = p + 1;
    }
    return sb.to_cstr();
}

// ─── Serializer ────────────────────────────────────────────────────────────

void json_write_string(StringBuilder* sb, const char* s) {
    if (!s) {
        sb.append_cstr("null");
        return;
    }
    sb.append_char('"');
    size_t n = (size_t)strlen(s);
    for (size_t i = 0; i < n; i = i + 1) {
        char c = s[i];
        if (c == '"') {
            sb.append_cstr("\\\"");
        } else if (c == '\\') {
            sb.append_cstr("\\\\");
        } else if (c == '\n') {
            sb.append_cstr("\\n");
        } else if (c == '\r') {
            sb.append_cstr("\\r");
        } else if (c == '\t') {
            sb.append_cstr("\\t");
        } else if (c == '\b') {
            sb.append_cstr("\\b");
        } else if (c == '\f') {
            sb.append_cstr("\\f");
        } else if ((unsigned char)c < 0x20) {
            char hex_buf[8];
            snprintf(hex_buf, sizeof(hex_buf), "\\u%04x", (unsigned int)(unsigned char)c);
            sb.append_cstr(hex_buf);
        } else {
            sb.append_char(c);
        }
    }
    sb.append_char('"');
}

void json_write_int(StringBuilder* sb, int n) {
    sb.append_int(n);
}

void json_write_i64(StringBuilder* sb, int64_t n) {
    char buf[64];
    snprintf(buf, sizeof(buf), "%lld", (long long)n);
    sb.append_cstr(buf);
}

void json_write_float(StringBuilder* sb, float n) {
    char buf[64];
    snprintf(buf, sizeof(buf), "%.7g", (double)n);
    sb.append_cstr(buf);
}

void json_write_double(StringBuilder* sb, double n) {
    char buf[64];
    snprintf(buf, sizeof(buf), "%.14g", n);
    sb.append_cstr(buf);
}

void json_write_bool(StringBuilder* sb, bool b) {
    if (b) {
        sb.append_cstr("true");
    } else {
        sb.append_cstr("false");
    }
}

void json_write_null(StringBuilder* sb) {
    sb.append_cstr("null");
}

void json_write_key(StringBuilder* sb, const char* key) {
    json_write_string(sb, key);
    sb.append_char(':');
}

void json_write_key_string(StringBuilder* sb, const char* key, const char* s) {
    json_write_key(sb, key);
    json_write_string(sb, s);
}

void json_write_key_int(StringBuilder* sb, const char* key, int n) {
    json_write_key(sb, key);
    json_write_int(sb, n);
}

void json_write_key_i64(StringBuilder* sb, const char* key, int64_t n) {
    json_write_key(sb, key);
    json_write_i64(sb, n);
}

void json_write_key_float(StringBuilder* sb, const char* key, float n) {
    json_write_key(sb, key);
    json_write_float(sb, n);
}

void json_write_key_double(StringBuilder* sb, const char* key, double n) {
    json_write_key(sb, key);
    json_write_double(sb, n);
}

void json_write_key_bool(StringBuilder* sb, const char* key, bool b) {
    json_write_key(sb, key);
    json_write_bool(sb, b);
}

void json_write_key_null(StringBuilder* sb, const char* key) {
    json_write_key(sb, key);
    json_write_null(sb);
}

struct JsonBuilder {
    sb: StringBuilder;
    depth: int;
    stack_kind: int[32];   // 1 = Object, 2 = Array
    stack_count: int[32];  // items count in container
    has_error: bool;
};

JsonBuilder json_builder_new(size_t cap) {
    JsonBuilder jb;
    jb.sb = sb_new(cap > 0 ? cap : 128);
    jb.depth = 0;
    jb.has_error = false;
    for (int i = 0; i < 32; i = i + 1) {
        jb.stack_kind[i] = 0;
        jb.stack_count[i] = 0;
    }
    return jb;
}

impl JsonBuilder {
    bool ok(JsonBuilder* self) {
        return !self->has_error && self->depth == 0;
    }

    void prepare_val(JsonBuilder* self) {
        if (self->has_error) return;
        if (self->depth > 0) {
            int cur_kind = self->stack_kind[self->depth - 1];
            if (cur_kind == 2) {
                if (self->stack_count[self->depth - 1] > 0) {
                    self->sb.append_char(',');
                }
                self->stack_count[self->depth - 1] = self->stack_count[self->depth - 1] + 1;
            } else if (cur_kind == 1) {
                if (self->stack_count[self->depth - 1] % 2 == 0) {
                    self->has_error = true;
                    return;
                }
                self->stack_count[self->depth - 1] = self->stack_count[self->depth - 1] + 1;
            }
        }
    }

    void begin_object(JsonBuilder* self) {
        if (self->has_error || self->depth >= 32) {
            self->has_error = true;
            return;
        }
        self->prepare_val();
        self->sb.append_char('{');
        self->stack_kind[self->depth] = 1;
        self->stack_count[self->depth] = 0;
        self->depth = self->depth + 1;
    }

    void end_object(JsonBuilder* self) {
        if (self->has_error || self->depth <= 0) {
            self->has_error = true;
            return;
        }
        if (self->stack_kind[self->depth - 1] != 1) {
            self->has_error = true;
            return;
        }
        if (self->stack_count[self->depth - 1] % 2 != 0) {
            self->has_error = true;
            return;
        }
        self->depth = self->depth - 1;
        self->sb.append_char('}');
    }

    void begin_array(JsonBuilder* self) {
        if (self->has_error || self->depth >= 32) {
            self->has_error = true;
            return;
        }
        self->prepare_val();
        self->sb.append_char('[');
        self->stack_kind[self->depth] = 2;
        self->stack_count[self->depth] = 0;
        self->depth = self->depth + 1;
    }

    void end_array(JsonBuilder* self) {
        if (self->has_error || self->depth <= 0) {
            self->has_error = true;
            return;
        }
        if (self->stack_kind[self->depth - 1] != 2) {
            self->has_error = true;
            return;
        }
        self->depth = self->depth - 1;
        self->sb.append_char(']');
    }

    void key(JsonBuilder* self, const char* k) {
        if (self->has_error || self->depth <= 0) {
            self->has_error = true;
            return;
        }
        if (self->stack_kind[self->depth - 1] != 1) {
            self->has_error = true;
            return;
        }
        if (self->stack_count[self->depth - 1] % 2 != 0) {
            self->has_error = true;
            return;
        }
        if (self->stack_count[self->depth - 1] > 0) {
            self->sb.append_char(',');
        }
        json_write_string(&self->sb, k);
        self->sb.append_char(':');
        self->stack_count[self->depth - 1] = self->stack_count[self->depth - 1] + 1;
    }

    void val_string(JsonBuilder* self, const char* val) {
        self->prepare_val();
        json_write_string(&self->sb, val);
    }

    void val_int(JsonBuilder* self, int val) {
        self->prepare_val();
        json_write_int(&self->sb, val);
    }

    void val_i64(JsonBuilder* self, int64_t val) {
        self->prepare_val();
        json_write_i64(&self->sb, val);
    }

    void val_float(JsonBuilder* self, float val) {
        self->prepare_val();
        json_write_float(&self->sb, val);
    }

    void val_double(JsonBuilder* self, double val) {
        self->prepare_val();
        json_write_double(&self->sb, val);
    }

    void val_bool(JsonBuilder* self, bool val) {
        self->prepare_val();
        json_write_bool(&self->sb, val);
    }

    void val_null(JsonBuilder* self) {
        self->prepare_val();
        json_write_null(&self->sb);
    }

    void key_string(JsonBuilder* self, const char* k, const char* val) {
        self->key(k);
        self->val_string(val);
    }

    void key_int(JsonBuilder* self, const char* k, int val) {
        self->key(k);
        self->val_int(val);
    }

    void key_i64(JsonBuilder* self, const char* k, int64_t val) {
        self->key(k);
        self->val_i64(val);
    }

    void key_float(JsonBuilder* self, const char* k, float val) {
        self->key(k);
        self->val_float(val);
    }

    void key_double(JsonBuilder* self, const char* k, double val) {
        self->key(k);
        self->val_double(val);
    }

    void key_bool(JsonBuilder* self, const char* k, bool val) {
        self->key(k);
        self->val_bool(val);
    }

    void key_null(JsonBuilder* self, const char* k) {
        self->key(k);
        self->val_null();
    }

    char* to_cstr(JsonBuilder* self) {
        return self->sb.to_cstr();
    }

    Str as_str(JsonBuilder* self) {
        return self->sb.as_str();
    }

    void destroy(JsonBuilder* self) {
        self->sb.destroy();
    }
};
