// Rook Standard Library - std/json.rook
// Flat-object & array JSON parser: field/element getters (string/int/float/bool/has) and writers.
// Safe pointer scanning, zero memory allocation on reads.

#include <stdio.h>
#include <stdbool.h>
#include <string.h>
#comprise <std/vec>

const char* json_skip_ws(const char* p) {
    while (true) {
        char c = p[0];
        if (c != ' ' && c != '\t' && c != '\n' && c != '\r') {
            break;
        }
        p = p + 1;
    }
    return p;
}

const char* json_skip_string(const char* p) {
    p = p + 1;
    while (p[0] != '\0') {
        if (p[0] == '\\') {
            if (p[1] != '\0') {
                p = p + 2;
            } else {
                p = p + 1;
            }
        } else if (p[0] == '"') {
            return p + 1;
        } else {
            p = p + 1;
        }
    }
    return p;
}

const char* json_skip_value(const char* p) {
    p = json_skip_ws(p);
    char c = p[0];
    if (c == '"') {
        return json_skip_string(p);
    }
    if (c == '{' || c == '[') {
        int depth = 1;
        p = p + 1;
        while (p[0] != '\0') {
            char d = p[0];
            if (d == '"') {
                p = json_skip_string(p);
            } else {
                if (d == '{' || d == '[') {
                    depth = depth + 1;
                }
                if (d == '}' || d == ']') {
                    depth = depth - 1;
                    if (depth == 0) {
                        return p + 1;
                    }
                }
                p = p + 1;
            }
        }
        return p;
    }
    while (p[0] != '\0' && p[0] != ',' && p[0] != '}' && p[0] != ']') {
        p = p + 1;
    }
    return p;
}

const char* json_find(const char* json, const char* key) {
    const char* p = json_skip_ws(json);
    if (p[0] != '{') {
        return NULL;
    }
    p = p + 1;
    size_t klen = (size_t)strlen(key);
    while (true) {
        p = json_skip_ws(p);
        if (p[0] == '}') {
            return NULL;
        }
        if (p[0] != '"') {
            return NULL;
        }
        const char* ks = p + 1;
        p = json_skip_string(p);
        bool hit = false;
        if (strncmp(ks, key, klen) == 0 && ks[klen] == '"') {
            hit = true;
        }
        p = json_skip_ws(p);
        if (p[0] != ':') {
            return NULL;
        }
        p = json_skip_ws(p + 1);
        if (hit) {
            return p;
        }
        p = json_skip_value(p);
        p = json_skip_ws(p);
        if (p[0] == ',') {
            p = p + 1;
        } else {
            return NULL;
        }
    }
    return NULL;
}

bool json_has_key(const char* json, const char* key) {
    return json_find(json, key) != NULL;
}

bool json_get_string(const char* json, const char* key, char* out, size_t cap) {
    const char* p = json_find(json, key);
    if (p == NULL) {
        return false;
    }
    if (p[0] != '"') {
        return false;
    }
    if (cap == 0) {
        return false;
    }
    p = p + 1;
    size_t n = 0;
    while (p[0] != '\0' && p[0] != '"') {
        char c = p[0];
        if (c == '\\') {
            p = p + 1;
            char e = p[0];
            if (e == '\0') {
                break;
            }
            if (e == 'n') {
                c = '\n';
            } else if (e == 'r') {
                c = '\r';
            } else if (e == 't') {
                c = '\t';
            } else if (e == 'b') {
                c = '\b';
            } else if (e == 'f') {
                c = '\f';
            } else {
                c = e;
            }
            p = p + 1;
        } else {
            p = p + 1;
        }
        if (n + 1 >= cap) {
            return false;
        }
        out[n] = c;
        n = n + 1;
    }
    if (p[0] != '"') {
        return false;
    }
    out[n] = '\0';
    return true;
}

bool json_get_int(const char* json, const char* key, int* out) {
    const char* p = json_find(json, key);
    if (p == NULL) {
        return false;
    }
    int sign = 1;
    if (p[0] == '-') {
        sign = -1;
        p = p + 1;
    }
    int val = 0;
    bool any = false;
    while (p[0] >= '0' && p[0] <= '9') {
        any = true;
        int digit = p[0] - '0';
        if (val > (2147483647 - digit) / 10) {
            if (out) {
                if (sign == 1) {
                    *out = 2147483647;
                } else {
                    *out = -2147483647 - 1;
                }
            }
            return true;
        }
        val = val * 10 + digit;
        p = p + 1;
    }
    if (!any) {
        return false;
    }
    if (out) {
        *out = val * sign;
    }
    return true;
}

bool json_get_float(const char* json, const char* key, float* out) {
    const char* p = json_find(json, key);
    if (p == NULL) {
        return false;
    }
    float sign = 1.0f;
    if (p[0] == '-') {
        sign = -1.0f;
        p = p + 1;
    } else if (p[0] == '+') {
        p = p + 1;
    }
    float int_part = 0.0f;
    bool any = false;
    while (p[0] >= '0' && p[0] <= '9') {
        any = true;
        int_part = int_part * 10.0f + (float)(p[0] - '0');
        p = p + 1;
    }
    float frac_part = 0.0f;
    float div = 1.0f;
    if (p[0] == '.') {
        p = p + 1;
        while (p[0] >= '0' && p[0] <= '9') {
            any = true;
            frac_part = frac_part * 10.0f + (float)(p[0] - '0');
            div = div * 10.0f;
            p = p + 1;
        }
    }
    if (!any) {
        return false;
    }
    float val = (int_part + (frac_part / div)) * sign;
    if (p[0] == 'e' || p[0] == 'E') {
        p = p + 1;
        int exp_sign = 1;
        if (p[0] == '-') {
            exp_sign = -1;
            p = p + 1;
        } else if (p[0] == '+') {
            p = p + 1;
        }
        int exp_val = 0;
        while (p[0] >= '0' && p[0] <= '9') {
            exp_val = exp_val * 10 + (p[0] - '0');
            p = p + 1;
        }
        float factor = 1.0f;
        for (int i = 0; i < exp_val; i = i + 1) {
            factor = factor * 10.0f;
        }
        if (exp_sign < 0) {
            val = val / factor;
        } else {
            val = val * factor;
        }
    }
    if (out) {
        *out = val;
    }
    return true;
}

bool json_get_bool(const char* json, const char* key, bool* out) {
    const char* p = json_find(json, key);
    if (p == NULL) {
        return false;
    }
    if (strncmp(p, "true", 4) == 0) {
        char t = p[4];
        if (t == ' ' || t == '\t' || t == '\n' || t == '\r' || t == ',' || t == '}' || t == ']' || t == '\0') {
            if (out) {
                *out = true;
            }
            return true;
        }
        return false;
    }
    if (strncmp(p, "false", 5) == 0) {
        char f = p[5];
        if (f == ' ' || f == '\t' || f == '\n' || f == '\r' || f == ',' || f == '}' || f == ']' || f == '\0') {
            if (out) {
                *out = false;
            }
            return true;
        }
        return false;
    }
    return false;
}

int json_get_array_len(const char* json, const char* key) {
    const char* p = json_find(json, key);
    if (p == NULL || p[0] != '[') {
        return -1;
    }
    p = json_skip_ws(p + 1);
    if (p[0] == ']') {
        return 0;
    }
    int count = 0;
    while (p[0] != '\0' && p[0] != ']') {
        p = json_skip_value(p);
        count = count + 1;
        p = json_skip_ws(p);
        if (p[0] == ',') {
            p = json_skip_ws(p + 1);
        } else if (p[0] == ']') {
            break;
        } else {
            break;
        }
    }
    return count;
}

const char* json_array_get_elem(const char* json, const char* key, int index) {
    if (index < 0) return NULL;
    const char* p = json_find(json, key);
    if (p == NULL || p[0] != '[') {
        return NULL;
    }
    p = json_skip_ws(p + 1);
    int curr = 0;
    while (p[0] != '\0' && p[0] != ']') {
        if (curr == index) {
            return p;
        }
        p = json_skip_value(p);
        curr = curr + 1;
        p = json_skip_ws(p);
        if (p[0] == ',') {
            p = json_skip_ws(p + 1);
        } else if (p[0] == ']') {
            break;
        } else {
            break;
        }
    }
    return NULL;
}

bool json_array_get_string(const char* json, const char* key, int index, char* out, size_t cap) {
    const char* p = json_array_get_elem(json, key, index);
    if (p == NULL || p[0] != '"' || cap == 0) return false;
    p = p + 1;
    size_t n = 0;
    while (p[0] != '\0' && p[0] != '"') {
        char c = p[0];
        if (c == '\\') {
            p = p + 1;
            char e = p[0];
            if (e == '\0') break;
            if (e == 'n') c = '\n';
            else if (e == 'r') c = '\r';
            else if (e == 't') c = '\t';
            else if (e == 'b') c = '\b';
            else if (e == 'f') c = '\f';
            else c = e;
            p = p + 1;
        } else {
            p = p + 1;
        }
        if (n + 1 >= cap) return false;
        out[n] = c;
        n = n + 1;
    }
    if (p[0] != '"') return false;
    out[n] = '\0';
    return true;
}

bool json_array_get_int(const char* json, const char* key, int index, int* out) {
    const char* p = json_array_get_elem(json, key, index);
    if (p == NULL) return false;
    int sign = 1;
    if (p[0] == '-') {
        sign = -1;
        p = p + 1;
    }
    int val = 0;
    bool any = false;
    while (p[0] >= '0' && p[0] <= '9') {
        any = true;
        int digit = p[0] - '0';
        if (val > (2147483647 - digit) / 10) {
            if (out) {
                if (sign == 1) *out = 2147483647;
                else *out = -2147483647 - 1;
            }
            return true;
        }
        val = val * 10 + digit;
        p = p + 1;
    }
    if (!any) return false;
    if (out) *out = val * sign;
    return true;
}

bool json_array_get_bool(const char* json, const char* key, int index, bool* out) {
    const char* p = json_array_get_elem(json, key, index);
    if (p == NULL) return false;
    if (strncmp(p, "true", 4) == 0) {
        char t = p[4];
        if (t == ' ' || t == '\t' || t == '\n' || t == '\r' || t == ',' || t == '}' || t == ']' || t == '\0') {
            if (out) *out = true;
            return true;
        }
        return false;
    }
    if (strncmp(p, "false", 5) == 0) {
        char f = p[5];
        if (f == ' ' || f == '\t' || f == '\n' || f == '\r' || f == ',' || f == '}' || f == ']' || f == '\0') {
            if (out) *out = false;
            return true;
        }
        return false;
    }
    return false;
}

bool json_array_get_float(const char* json, const char* key, int index, float* out) {
    const char* p = json_array_get_elem(json, key, index);
    if (p == NULL) return false;
    float sign = 1.0f;
    if (p[0] == '-') {
        sign = -1.0f;
        p = p + 1;
    } else if (p[0] == '+') {
        p = p + 1;
    }
    float int_part = 0.0f;
    bool any = false;
    while (p[0] >= '0' && p[0] <= '9') {
        any = true;
        int_part = int_part * 10.0f + (float)(p[0] - '0');
        p = p + 1;
    }
    float frac_part = 0.0f;
    float div = 1.0f;
    if (p[0] == '.') {
        p = p + 1;
        while (p[0] >= '0' && p[0] <= '9') {
            any = true;
            frac_part = frac_part * 10.0f + (float)(p[0] - '0');
            div = div * 10.0f;
            p = p + 1;
        }
    }
    if (!any) return false;
    float val = (int_part + (frac_part / div)) * sign;
    if (p[0] == 'e' || p[0] == 'E') {
        p = p + 1;
        int exp_sign = 1;
        if (p[0] == '-') {
            exp_sign = -1;
            p = p + 1;
        } else if (p[0] == '+') {
            p = p + 1;
        }
        int exp_val = 0;
        while (p[0] >= '0' && p[0] <= '9') {
            exp_val = exp_val * 10 + (p[0] - '0');
            p = p + 1;
        }
        float factor = 1.0f;
        for (int i = 0; i < exp_val; i = i + 1) {
            factor = factor * 10.0f;
        }
        if (exp_sign < 0) val = val / factor;
        else val = val * factor;
    }
    if (out) *out = val;
    return true;
}

void json_write_string(StringBuilder* sb, const char* s) {
    if (!s) {
        sb.append_cstr("null");
        return;
    }
    sb.append_char('"');
    size_t n = (size_t)strlen(s);
    for (size_t i = 0; i < n; i = i + 1) {
        char c = s[i];
        if (c == '"') {
            sb.append_cstr("\\\"");
        } else if (c == '\\') {
            sb.append_cstr("\\\\");
        } else if (c == '\n') {
            sb.append_cstr("\\n");
        } else if (c == '\r') {
            sb.append_cstr("\\r");
        } else if (c == '\t') {
            sb.append_cstr("\\t");
        } else if (c == '\b') {
            sb.append_cstr("\\b");
        } else if (c == '\f') {
            sb.append_cstr("\\f");
        } else {
            sb.append_char(c);
        }
    }
    sb.append_char('"');
}

void json_write_int(StringBuilder* sb, int n) {
    sb.append_int(n);
}

void json_write_float(StringBuilder* sb, float n) {
    sb.append_float(n);
}

void json_write_bool(StringBuilder* sb, bool b) {
    if (b) {
        sb.append_cstr("true");
    } else {
        sb.append_cstr("false");
    }
}

void json_write_null(StringBuilder* sb) {
    sb.append_cstr("null");
}

void json_write_key(StringBuilder* sb, const char* key) {
    json_write_string(sb, key);
    sb.append_char(':');
}

void json_write_key_string(StringBuilder* sb, const char* key, const char* s) {
    json_write_key(sb, key);
    json_write_string(sb, s);
}

void json_write_key_int(StringBuilder* sb, const char* key, int n) {
    json_write_key(sb, key);
    json_write_int(sb, n);
}

void json_write_key_float(StringBuilder* sb, const char* key, float n) {
    json_write_key(sb, key);
    json_write_float(sb, n);
}

void json_write_key_bool(StringBuilder* sb, const char* key, bool b) {
    json_write_key(sb, key);
    json_write_bool(sb, b);
}

void json_write_key_null(StringBuilder* sb, const char* key) {
    json_write_key(sb, key);
    json_write_null(sb);
}
