// Rook Standard Library - std/log.rook
// Leveled logging with runtime level filter: debug/info -> stdout, warn/error -> stderr.

#comprise <std/io>
#comprise <std/str>

enum LogLevel {
    Debug,
    Info,
    Warn,
    Error
}

int log_level_debug() {
    return 0;
}

int log_level_info() {
    return 1;
}

int log_level_warn() {
    return 2;
}

int log_level_error() {
    return 3;
}

object Logger {
    level: int
}

Logger log_new(int level) {
    int lvl = level;
    if (lvl < 0) {
        lvl = 0;
    }
    if (lvl > 3) {
        lvl = 3;
    }
    return Logger { level: lvl };
}

impl Logger {
    void set_level(Logger* self, int level) {
        if (level < 0) {
            level = 0;
        }
        if (level > 3) {
            level = 3;
        }
        self->level = level;
    }

    int get_level(Logger* self) {
        return self->level;
    }

    void log(Logger* self, int level, const char* msg) {
        if (level == 0) {
            self.debug(msg);
        } else if (level == 1) {
            self.info(msg);
        } else if (level == 2) {
            self.warn(msg);
        } else if (level == 3) {
            self.error(msg);
        }
    }

    void debug(Logger* self, const char* msg) {
        if (self->level <= 0) {
            print("DEBUG ");
            println(msg);
        }
    }

    void info(Logger* self, const char* msg) {
        if (self->level <= 1) {
            print("INFO ");
            println(msg);
        }
    }

    void warn(Logger* self, const char* msg) {
        if (self->level <= 2) {
            eprint("WARN ");
            eprintln(msg);
        }
    }

    void error(Logger* self, const char* msg) {
        if (self->level <= 3) {
            eprint("ERROR ");
            eprintln(msg);
        }
    }

    void debug_int(Logger* self, const char* label, int val) {
        if (self->level <= 0) {
            print("DEBUG ");
            print(label);
            print(": ");
            println_int(val);
        }
    }

    void info_int(Logger* self, const char* label, int val) {
        if (self->level <= 1) {
            print("INFO ");
            print(label);
            print(": ");
            println_int(val);
        }
    }

    void warn_int(Logger* self, const char* label, int val) {
        if (self->level <= 2) {
            eprint("WARN ");
            eprint(label);
            eprint(": ");
            eprintln_int(val);
        }
    }

    void error_int(Logger* self, const char* label, int val) {
        if (self->level <= 3) {
            eprint("ERROR ");
            eprint(label);
            eprint(": ");
            eprintln_int(val);
        }
    }

    void debug_str(Logger* self, const char* label, Str s) {
        if (self->level <= 0) {
            print("DEBUG ");
            print(label);
            print(": ");
            println_str(s);
        }
    }

    void info_str(Logger* self, const char* label, Str s) {
        if (self->level <= 1) {
            print("INFO ");
            print(label);
            print(": ");
            println_str(s);
        }
    }
}

// Global default logger convenience functions
static int _global_log_level = 1;

void log_set_global_level(int level) {
    if (level < 0) level = 0;
    if (level > 3) level = 3;
    _global_log_level = level;
}

int log_get_global_level() {
    return _global_log_level;
}

void log_debug(const char* msg) {
    if (_global_log_level <= 0) {
        print("DEBUG ");
        println(msg);
    }
}

void log_info(const char* msg) {
    if (_global_log_level <= 1) {
        print("INFO ");
        println(msg);
    }
}

void log_warn(const char* msg) {
    if (_global_log_level <= 2) {
        eprint("WARN ");
        eprintln(msg);
    }
}

void log_error(const char* msg) {
    if (_global_log_level <= 3) {
        eprint("ERROR ");
        eprintln(msg);
    }
}
