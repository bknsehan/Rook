// Rook Standard Library - std/str.rook
// Safe, non-owning string slice (Str) with bounds-checked slicing, searching, and parsing.

#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include <stdint.h>
#include <stdbool.h>
#include <errno.h>

struct Str {
    data: const char*;
    len: size_t;
};

Str str_from_cstr(const char* s) {
    if (s == NULL) return Str { data: "", len: 0 };
    return Str { data: s, len: (size_t)strlen(s) };
}

Str str_from_parts(const char* data, size_t len) {
    if (data == NULL) return Str { data: "", len: 0 };
    return Str { data: data, len: len };
}

impl Str {
    bool is_empty(self) {
        return self.len == 0;
    }

    Str slice(self, size_t start, size_t end) {
        if (start >= self.len || start >= end) {
            return Str { data: "", len: 0 };
        }
        if (end > self.len) end = self.len;
        return Str {
            data: self.data + start,
            len: end - start
        };
    }

    bool equals(self, Str other) {
        if (self.len != other.len) return false;
        if (self.len == 0) return true;
        return memcmp(self.data, other.data, self.len) == 0;
    }

    bool equals_cstr(self, const char* s) {
        if (s == NULL) return self.len == 0;
        size_t slen = (size_t)strlen(s);
        if (self.len != slen) return false;
        return memcmp(self.data, s, self.len) == 0;
    }

    bool starts_with(self, Str prefix) {
        if (prefix.len > self.len) return false;
        if (prefix.len == 0) return true;
        return memcmp(self.data, prefix.data, prefix.len) == 0;
    }

    bool ends_with(self, Str suffix) {
        if (suffix.len > self.len) return false;
        if (suffix.len == 0) return true;
        size_t offset = self.len - suffix.len;
        return memcmp(self.data + offset, suffix.data, suffix.len) == 0;
    }

    char char_at(self, size_t index) {
        if (index >= self.len) return '\0';
        return self.data[index];
    }

    Str trim_start(self) {
        size_t start = 0;
        while (start < self.len) {
            char c = self.data[start];
            if (c != ' ' && c != '\t' && c != '\n' && c != '\r') break;
            start = start + 1;
        }
        return Str { data: self.data + start, len: self.len - start };
    }

    Str trim_end(self) {
        size_t end = self.len;
        while (end > 0) {
            char c = self.data[end - 1];
            if (c != ' ' && c != '\t' && c != '\n' && c != '\r') break;
            end = end - 1;
        }
        return Str { data: self.data, len: end };
    }

    Str trim(self) {
        Str ts = self.trim_start();
        return ts.trim_end();
    }

    int find_char(self, char c) {
        for (size_t i = 0; i < self.len; i = i + 1) {
            if (self.data[i] == c) return (int)i;
        }
        return -1;
    }

    int find(self, Str needle) {
        if (needle.len == 0) return 0;
        if (needle.len > self.len) return -1;
        size_t limit = self.len - needle.len;
        for (size_t i = 0; i <= limit; i = i + 1) {
            if (memcmp(self.data + i, needle.data, needle.len) == 0) return (int)i;
        }
        return -1;
    }

    bool contains(self, Str needle) {
        return self.find(needle) >= 0;
    }

    bool split_once(self, char delim, Str* left, Str* right) {
        int idx = self.find_char(delim);
        if (idx < 0) {
            if (left) *left = *self;
            if (right) *right = Str { data: "", len: 0 };
            return false;
        }
        if (left) *left = Str { data: self.data, len: (size_t)idx };
        if (right) *right = Str { data: self.data + idx + 1, len: self.len - (size_t)idx - 1 };
        return true;
    }

    bool try_to_int(self, int* out) {
        if (self.len == 0) return false;
        char buf[64];
        if (self.len >= sizeof(buf)) return false;
        memcpy(buf, self.data, self.len);
        buf[self.len] = '\0';
        char* endptr = NULL;
        errno = 0;
        long val = strtol(buf, &endptr, 10);
        if (endptr == buf || endptr != buf + self.len) return false;
        if (errno == ERANGE || val > 2147483647L || val < -2147483647L - 1L) return false;
        if (out) *out = (int)val;
        return true;
    }

    bool try_to_i64(self, int64_t* out) {
        if (self.len == 0) return false;
        char buf[64];
        if (self.len >= sizeof(buf)) return false;
        memcpy(buf, self.data, self.len);
        buf[self.len] = '\0';
        char* endptr = NULL;
        errno = 0;
        long long val = strtoll(buf, &endptr, 10);
        if (endptr == buf || endptr != buf + self.len) return false;
        if (errno == ERANGE) return false;
        if (val == 9223372036854775807LL || val == -9223372036854775807LL - 1LL) {
            size_t i = 0;
            if (buf[0] == '+' || buf[0] == '-') i = 1;
            while (buf[i] == '0' && buf[i + 1] != '\0') i = i + 1;
            size_t dlen = (size_t)strlen(buf + i);
            if (dlen > 19) return false;
            if (dlen == 19) {
                if (buf[0] == '-') {
                    if (strcmp(buf + i, "9223372036854775808") > 0) return false;
                } else {
                    if (strcmp(buf + i, "9223372036854775807") > 0) return false;
                }
            }
        }
        if (out) *out = (int64_t)val;
        return true;
    }

    bool try_to_float(self, float* out) {
        if (self.len == 0) return false;
        char buf[64];
        if (self.len >= sizeof(buf)) return false;
        memcpy(buf, self.data, self.len);
        buf[self.len] = '\0';
        char* endptr = NULL;
        errno = 0;
        float val = strtof(buf, &endptr);
        if (endptr == buf || endptr != buf + self.len) return false;
        if (errno == ERANGE) return false;
        if (out) *out = val;
        return true;
    }

    bool try_to_double(self, double* out) {
        if (self.len == 0) return false;
        char buf[64];
        if (self.len >= sizeof(buf)) return false;
        memcpy(buf, self.data, self.len);
        buf[self.len] = '\0';
        char* endptr = NULL;
        errno = 0;
        double val = strtod(buf, &endptr);
        if (endptr == buf || endptr != buf + self.len) return false;
        if (errno == ERANGE) return false;
        if (out) *out = val;
        return true;
    }

    int to_int(self) {
        int val = 0;
        if (self.try_to_int(&val)) return val;
        if (self.len > 0) {
            if (self.data[0] == '-') return -2147483647 - 1;
            if (self.data[0] >= '0' && self.data[0] <= '9') return 2147483647;
            if (self.data[0] == '+' && self.len > 1 && self.data[1] >= '0' && self.data[1] <= '9') return 2147483647;
        }
        return 0;
    }

    int64_t to_i64(self) {
        int64_t val = 0;
        if (self.try_to_i64(&val)) return val;
        if (self.len > 0) {
            if (self.data[0] == '-') return -9223372036854775807LL - 1LL;
            if (self.data[0] >= '0' && self.data[0] <= '9') return 9223372036854775807LL;
            if (self.data[0] == '+' && self.len > 1 && self.data[1] >= '0' && self.data[1] <= '9') return 9223372036854775807LL;
        }
        return 0;
    }

    float to_float(self) {
        float val = 0.0f;
        self.try_to_float(&val);
        return val;
    }

    double to_double(self) {
        double val = 0.0;
        self.try_to_double(&val);
        return val;
    }

    bool to_bool(self) {
        if (self.equals_cstr("true") || self.equals_cstr("1")) return true;
        return false;
    }

    int compare(self, Str other) {
        size_t min_len = self.len < other.len ? self.len : other.len;
        if (min_len > 0) {
            int cmp = memcmp(self.data, other.data, min_len);
            if (cmp != 0) return cmp < 0 ? -1 : 1;
        }
        if (self.len < other.len) return -1;
        if (self.len > other.len) return 1;
        return 0;
    }

    void print(self) {
        printf("%.*s", (int)self.len, self.data);
    }

    void println(self) {
        printf("%.*s\n", (int)self.len, self.data);
    }

    char* to_cstr(self) {
        char* buf = malloc(self.len + 1);
        if (!buf) return NULL;
        memcpy(buf, self.data, self.len);
        buf[self.len] = '\0';
        return buf;
    }

    char* clone(self) {
        return self.to_cstr();
    }
}

bool char_is_digit(char c) {
    return c >= '0' && c <= '9';
}

bool char_is_alpha(char c) {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_';
}

bool char_is_space(char c) {
    return c == ' ' || c == '\t' || c == '\n' || c == '\r';
}
