#include <stdio.h>

// 1. Primitive return
auto add(int a, int b) {
    return a + b;
}

// 2. String literal return
auto get_msg() {
    return "rook auto functions";
}

// 3. Void auto functions
auto do_print() {
    printf("side effect\n");
}

auto do_nothing() {
    return;
}

// 4. Recursion with base case
auto fact(int n) {
    if (n <= 1) return 1;
    return n * fact(n - 1);
}

// 5. Forward call to auto function defined below
auto caller(int x) {
    return callee(x) + 1;
}

auto callee(int x) {
    return x * 10;
}

// 6. Impl methods
struct Vec {
    int x;
    int y;
};

impl Vec {
    auto dot(Vec* self, Vec other) {
        return self->x * other.x + self->y * other.y;
    }
}

int main() {
    auto s = add(3, 4);
    auto msg = get_msg();
    do_print();
    do_nothing();
    auto f = fact(5);
    auto c = caller(5);

    Vec v1 = Vec{ x: 2, y: 3 };
    Vec v2 = Vec{ x: 4, y: 5 };
    auto d = v1.dot(v2);

    printf("s=%d msg=%s f=%d c=%d d=%d\n", s, msg, f, c, d);
    return 0;
}
