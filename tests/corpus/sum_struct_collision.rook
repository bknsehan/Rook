#include <stdio.h>

struct Rect {
    w: int;
    h: int;
};

sum Shape {
    Rect {
        w: int;
        h: int;
    };
    Point;
};

int area_struct(Rect r) {
    return r.w * r.h;
}

int area_shape(Shape s) {
    return match (s) {
        Shape.Rect { w, h } => w * h,
        Shape.Point => 0,
    };
}

int main() {
    Rect r = Rect { w: 10, h: 20 };
    printf("struct Rect area: %d\n", area_struct(r));

    Shape s1 = Shape.Point;
    printf("Shape.Point area: %d\n", area_shape(s1));

    Shape s2 = Shape.Rect { w: 30, h: 40 };
    printf("Shape.Rect area: %d\n", area_shape(s2));

    return 0;
}
