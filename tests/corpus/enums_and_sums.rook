#include <stdio.h>

// 1. Classic C Enum
enum Dir { Up, Down }

// 2. Struct with same name as a sum variant (disambiguation test)
struct Rect {
    w: int;
    h: int;
};

int area_struct(Rect r) {
    return r.w * r.h;
}

// 3. Tagged Union / Sum Type
sum Shape {
    Circle { r: float; };
    Rect { w: int; h: int; };
    Big { x1: int; x2: int; x3: int; x4: int; x5: int; };
    Point;
};

impl Shape {
    float area(Shape* self) {
        return match (*self) {
            Shape.Circle { r } => 3.14159265f * (float)(r * r),
            Shape.Rect { w, h } => (float)(w * h),
            Shape.Big { x1, x2, x3, x4, x5 } => (float)(x1 + x2 + x3 + x4 + x5),
            Shape.Point => 0.0f,
            _ => 0.0f,
        };
    }
}

int main() {
    // 1. Enum matching & comparison
    Dir d = Up;
    match (d) {
        Up => printf("dir: up\n"),
        Down => printf("dir: down\n"),
        _ => printf("dir: other\n")
    }
    printf("enum eq=%d ne=%d\n", Up == Up, Up == Down);

    // 2. Integer matching
    int x = 42;
    match (x) {
        1 => printf("one\n"),
        42 => printf("answer\n"),
        _ => printf("other\n")
    }

    // 3. Disambiguation: Struct Rect vs Shape.Rect
    Rect r = Rect { w: 10, h: 20 };
    printf("struct Rect area: %d\n", area_struct(r));

    Shape s_rect = Shape.Rect { w: 30, h: 40 };
    Shape s_circ = Shape.Circle { r: 2.0f };
    Shape s_pt = Shape.Point;
    Shape s_big = Shape.Big { x1: 1, x2: 2, x3: 3, x4: 4, x5: 5 };

    printf("s_rect area: %.0f\n", s_rect.area());
    printf("s_circ area: %.2f\n", s_circ.area());
    printf("s_pt area: %.0f\n", s_pt.area());
    printf("s_big area: %.0f\n", s_big.area());

    return 0;
}
