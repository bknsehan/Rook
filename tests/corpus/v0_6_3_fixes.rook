#include <stdio.h>
#include <stdlib.h>
#include <assert.h>

struct TestBox {
    int value;
};

impl TestBox {
    int get_val(self) {
        return self.value;
    }
}

void* alloc_int(int val) {
    int* p = (int*)malloc(sizeof(int));
    if (!p) return NULL;
    *p = val;
    return p;
}

int main() {
    // 1. void* return function
    int* p = (int*)alloc_int(1234);
    if (p) {
        printf("alloc_int: %d\n", *p);
        free(p);
    }

    // 2. sizeof array element indexing and pointer dereference
    int numbers[4] = {10, 20, 30, 40};
    int len = sizeof(numbers) / sizeof(numbers[0]);
    printf("len: %d\n", len);

    int* nptr = numbers;
    size_t sz_elem = sizeof(*nptr);
    printf("elem size matches int: %d\n", sz_elem == sizeof(int));

    // 3. assert function call
    assert(len == 4);
    printf("assert: ok\n");

    // 4. struct impl method
    TestBox box = TestBox { value: 999 };
    printf("box: %d\n", box.get_val());

    return 0;
}
