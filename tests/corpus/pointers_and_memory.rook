#include <stdio.h>

void greet(const char* name) {
    printf("%s\n", name);
}

int double_it(int name) {
    return name * 2;
}

int main() {
    // 1. Unsigned arithmetic
    unsigned int a = 4000000000u;
    printf("%u %d\n", a / 2u, (a > 2u));

    // 2. Pointer arithmetic
    int arr[5] = {10, 20, 30, 40, 50};
    int* p = arr;
    printf("%d %d\n", *(p + 1), *p);
    p++;
    printf("%d\n", *p);
    auto diff = &arr[4] - &arr[0];
    printf("diff=%d\n", (int)diff);

    // 3. Variable shadowing & scopes
    int name = 5;
    printf("shadowed: %d\n", double_it(name));
    greet("scope OK");

    return 0;
}
