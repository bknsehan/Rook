#include <stdio.h>

typedef struct CPoint {
    int x;
    int y;
} CPoint;

int square(int n) {
    return n * n;
}

struct YPoint {
    int a;
    int b;
}

int double_it(int n) {
    return n * 2;
}

int main() {
    CPoint p = {3, 4};
    let a = square(p.x);
    int b = double_it(a);
    YPoint q;
    q.a = 10;
    q.b = 20;
    printf("%d %d %d\n", a, b, q.a + q.b);
    return 0;
}
