#comprise <std/json>

int main() {
    const char* doc = "{\"name\": \"Ada \\\"the\\\" Great\", \"n\": -42, \"ok\": true, \"sub\": {\"x\": 1}}";
    char name[64];
    int n = 0;
    bool ok = false;
    bool f1 = json_get_string(doc, "name", name, 64);
    bool f2 = json_get_int(doc, "n", &n);
    bool f3 = json_get_bool(doc, "ok", &ok);
    bool f4 = json_has_key(doc, "sub");
    bool f5 = json_has_key(doc, "zzz");
    printf("found=%d name=%s n=%d ok=%d sub=%d missing=%d\n", f1 && f2 && f3 && f4 && !f5, name, n, ok, f4, !f5);
    StringBuilder sb = sb_new(64);
    defer sb.destroy();
    sb.append_cstr("{");
    json_write_string(&sb, "a\"b");
    sb.append_cstr(":");
    json_write_int(&sb, -7);
    sb.append_cstr(",");
    json_write_bool(&sb, true);
    sb.append_cstr(",");
    json_write_null(&sb);
    sb.append_cstr("}");
    printf("%s\n", sb.to_cstr());

    const char* doc2 = "{\"score\": 3.14, \"tags\": [\"first\", \"second\"], \"counts\": [10, 20, 30]}";
    float sc = 0.0f;
    bool f_sc = json_get_float(doc2, "score", &sc);
    int tag_len = json_get_array_len(doc2, "tags");
    char tag0[16];
    bool f_tag0 = json_array_get_string(doc2, "tags", 0, tag0, 16);
    int c1 = 0;
    bool f_c1 = json_array_get_int(doc2, "counts", 1, &c1);
    printf("float_ok=%d sc=%.2f tag_len=%d tag0=%s c1=%d\n", f_sc && f_tag0 && f_c1, (double)sc, tag_len, tag0, c1);

    StringBuilder sb2 = sb_new(64);
    defer sb2.destroy();
    sb2.append_cstr("{");
    json_write_key_string(&sb2, "key", "val");
    sb2.append_cstr(",");
    json_write_key_float(&sb2, "pi", 3.14f);
    sb2.append_cstr("}");
    printf("%s\n", sb2.to_cstr());
    return 0;
}
