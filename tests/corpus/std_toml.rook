#include <stdio.h>
#include <stdbool.h>
#include <string.h>
#comprise <std/toml>

int main() {
    const char* toml_text = "# Project configuration\ntitle = \"Rook Project\"\nversion = 7\nready = true\n\n[owner]\nname = \"Ada\"\nid = 101\n\n[database]\nserver = '192.168.1.100'\nport = 5432\nconnections = 5_000\ntimeout = 12.5\nssl = false\nprotocols = [ \"tcp\", \"tls\", \"quic\" ]\nhex_code = 0x2A\n\n[[servers]]\nname = \"alpha\"\nip = \"10.0.0.1\"\nactive = true\n\n[[servers]]\nname = \"beta\"\nip = \"10.0.0.2\"\nactive = false\n";

    // 1. Root keys
    char title[64];
    int ver = 0;
    bool ready = false;
    bool r1 = toml_get_string(toml_text, NULL, "title", title, 64);
    bool r2 = toml_get_int(toml_text, NULL, "version", &ver);
    bool r3 = toml_get_bool(toml_text, "", "ready", &ready);
    printf("root: title=%s ver=%d ready=%d ok=%d\n", title, ver, (int)ready, r1 && r2 && r3);

    // 2. Sections
    bool has_owner = toml_has_section(toml_text, "owner");
    bool has_db = toml_has_section(toml_text, "database");
    bool has_fake = toml_has_section(toml_text, "nonexistent");
    char name[32];
    int oid = 0;
    toml_get_string(toml_text, "owner", "name", name, 32);
    toml_get_int(toml_text, "owner", "id", &oid);
    printf("owner: has=%d,%d,%d name=%s id=%d\n", has_owner, has_db, !has_fake, name, oid);

    // 3. Database section with literal strings, hex, underscores, floats
    char srv[32];
    int port = 0;
    int conns = 0;
    float timeout = 0.0f;
    bool ssl = true;
    int hex_val = 0;
    toml_get_string(toml_text, "database", "server", srv, 32);
    toml_get_int(toml_text, "database", "port", &port);
    toml_get_int(toml_text, "database", "connections", &conns);
    toml_get_float(toml_text, "database", "timeout", &timeout);
    toml_get_bool(toml_text, "database", "ssl", &ssl);
    toml_get_int(toml_text, "database", "hex_code", &hex_val);
    printf("db: server=%s port=%d conns=%d timeout=%.1f ssl=%d hex=%d\n",
           srv, port, conns, (double)timeout, (int)ssl, hex_val);

    // 4. Arrays
    int proto_len = toml_get_array_len(toml_text, "database", "protocols");
    char p0[16];
    char p1[16];
    char p2[16];
    toml_array_get_string(toml_text, "database", "protocols", 0, p0, 16);
    toml_array_get_string(toml_text, "database", "protocols", 1, p1, 16);
    toml_array_get_string(toml_text, "database", "protocols", 2, p2, 16);
    printf("array: len=%d items=%s,%s,%s\n", proto_len, p0, p1, p2);

    // 5. Array of tables ([[servers]])
    int n_servers = toml_table_count(toml_text, "servers");
    char s0_name[16];
    char s0_ip[16];
    bool s0_active = false;
    toml_table_get_string(toml_text, "servers", 0, "name", s0_name, 16);
    toml_table_get_string(toml_text, "servers", 0, "ip", s0_ip, 16);
    toml_table_get_bool(toml_text, "servers", 0, "active", &s0_active);

    char s1_name[16];
    char s1_ip[16];
    bool s1_active = true;
    toml_table_get_string(toml_text, "servers", 1, "name", s1_name, 16);
    toml_table_get_string(toml_text, "servers", 1, "ip", s1_ip, 16);
    toml_table_get_bool(toml_text, "servers", 1, "active", &s1_active);
    printf("tables: count=%d s0=%s(%s,%d) s1=%s(%s,%d)\n",
           n_servers, s0_name, s0_ip, (int)s0_active, s1_name, s1_ip, (int)s1_active);

    // 6. TomlBuilder serializer test
    TomlBuilder tb = toml_builder_new(128);
    defer tb.destroy();
    tb.comment("Generated by Rook");
    tb.section("rokade");
    tb.set_string("target", "native");
    tb.set_int("opt", 3);
    tb.set_bool("debug", false);

    char* serialized = tb.to_cstr();

    char t_target[32];
    int t_opt = 0;
    bool t_debug = true;
    toml_get_string(serialized, "rokade", "target", t_target, 32);
    toml_get_int(serialized, "rokade", "opt", &t_opt);
    toml_get_bool(serialized, "rokade", "debug", &t_debug);
    printf("builder: target=%s opt=%d debug=%d\n", t_target, t_opt, (int)t_debug);

    // 7. Advanced TOML: inf, nan, datetime, dotted keys, inline tables, single-quoted keys, 64-bit int
    const char* adv_toml = "a.b = 1\n'my key' = 100\n\"quoted.key\" = 200\nbig = 9999999999\nval_inf = inf\nval_nan = nan\ncreated = 1979-05-27T07:32:00Z\nserver = { host = \"localhost\", port = 8080 }\n";
    int val_ab = 0;
    toml_get_int(adv_toml, "a", "b", &val_ab);
    int val_sq = 0;
    toml_get_int(adv_toml, "", "my key", &val_sq);
    int64_t big_int = 0;
    toml_get_i64(adv_toml, "", "big", &big_int);
    double v_inf = 0.0;
    toml_get_double(adv_toml, "", "val_inf", &v_inf);
    char dt[32];
    toml_get_string(adv_toml, "", "created", dt, 32);
    char in_host[32];
    toml_get_string(adv_toml, "server", "host", in_host, 32);
    int in_port = 0;
    toml_get_int(adv_toml, "", "server.port", &in_port);
    int host_t = (int)toml_get_type(adv_toml, "server", "host");
    int port_t = (int)toml_get_type(adv_toml, "server", "port");
    printf("advanced_toml: ab=%d sq=%d big=%lld isinf=%d dt=%s host=%s port=%d types=%d,%d\n",
           val_ab, val_sq, (long long)big_int, (int)isinf(v_inf), dt, in_host, in_port, host_t, port_t);

    // 8. Bracket in strings, datetime range rejection, toml_find_pos, builder literal & array setters
    const char* bracket_toml = "arr = [ \"]\", \"]\" ]\n[sec]\nport = 9000\n";
    int b_len = toml_get_array_len(bracket_toml, "", "arr");
    bool bad_date_rejected = !toml_is_date_time("9999-99-99") && toml_is_date_time("2026-09-19");
    int sec_l = 0;
    int sec_c = 0;
    bool pos_ok = toml_find_pos(bracket_toml, "sec", "port", &sec_l, &sec_c) && sec_l == 3;

    TomlBuilder tb2 = toml_builder_new(128);
    defer tb2.destroy();
    tb2.set_literal_string("quote", "it's working");
    tb2.set_string("ctrl", "\x02");
    const char* s_items[2];
    s_items[0] = "x";
    s_items[1] = "y";
    tb2.set_array_strings("letters", s_items, 2);
    char* b2_str = tb2.to_cstr();
    bool builder2_ok = (strstr(b2_str, "quote = \"it's working\"") != NULL) &&
                       (strstr(b2_str, "\\u0002") != NULL) &&
                       (strstr(b2_str, "letters = [\"x\", \"y\"]") != NULL);
    printf("toml_nits: b_len=%d bad_date_rejected=%d pos_ok=%d builder2_ok=%d\n",
           b_len, bad_date_rejected, pos_ok, builder2_ok);

    return 0;
}

