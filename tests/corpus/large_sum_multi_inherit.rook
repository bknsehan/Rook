#include <stdio.h>

sum BigPayload {
    A { x1: int; x2: int; x3: int; x4: int; x5: int; x6: int; x7: int; x8: int; x9: int; x10: int; };
    B { val: int; };
}

object BaseA {
    a: int
}

object MidB : BaseA {
    b: int
}

object SubC : MidB {
    c: int
}

impl SubC {
    void print_all(self) {
        printf("%d %d %d\n", self.a, self.b, self.c);
    }
}

int main() {
    BigPayload big = A { x1: 1, x2: 2, x3: 3, x4: 4, x5: 5, x6: 6, x7: 7, x8: 8, x9: 9, x10: 10 };
    int s = match (big) {
        A { x1, x2, x3, x4, x5, x6, x7, x8, x9, x10 } => x1 + x2 + x3 + x4 + x5 + x6 + x7 + x8 + x9 + x10,
        _ => 0,
    };
    printf("%d\n", s);

    SubC obj = SubC{ a: 10, b: 20, c: 30 };
    obj.print_all();
    return 0;
}
