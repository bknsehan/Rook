#comprise <std/log>

int main() {
    Logger log = log_new(log_level_info());
    log.debug("dbg-hidden");
    log.info("info-shown");
    log.warn("warn-to-stderr");
    log.error("error-to-stderr");
    log.set_level(log_level_debug());
    log.debug("dbg-shown");
    log.info_int("tasks", 3);
    printf("level=%d\n", log.get_level());

    // Global logger
    log_set_global_level(1);
    log_debug("global-dbg-hidden");
    log_info("global-info-shown");
    log_warn("global-warn-stderr");
    return 0;
}
