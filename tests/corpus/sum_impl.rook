#include <stdio.h>

sum Shape {
  Circle { r: float; };
  Rect { w: float; h: float; };
  Point;
}

impl Shape {
  float area(Shape* self) {
    return match (*self) {
      Circle { r }       => 3.14159265 * r * r,
      Rect { w, h }      => w * h,
      Point              => 0.0,
      _                  => 0.0,
    };
  }
}

int main() {
  Shape a = Circle { r: 2.0 };
  Shape b = Rect { w: 3.0, h: 4.0 };
  Shape c = Point;
  printf("%f\n", a.area());
  printf("%f\n", b.area());
  printf("%f\n", c.area());
  return 0;
}
