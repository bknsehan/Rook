#include <stdio.h>
#comprise base

struct Animal {
    name: const char*;
    age: int;
};

impl Animal {
    void speak(self) {
        printf("%s speaks!\n", self.name);
    }
}

struct Dog : Animal {
    breed: const char*;
};

impl Dog {
    void bark(self) {
        printf("%s barks (%s)!\n", self.name, self.breed);
    }
}
